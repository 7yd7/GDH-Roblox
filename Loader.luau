MODULES["src/Function/Keyboard.luau"] = function()
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local GuiService = game:GetService("GuiService")
local StarterGui = game:GetService("StarterGui")

local Keyboard = {}

local attached = setmetatable({}, { __mode = "k" })
local wanted: TextBox? = nil
local wantedUntil = 0
local inputConn: RBXScriptConnection? = nil
local renderConn: RBXScriptConnection? = nil

local function safe(getter: () -> any): any
    local ok, value = pcall(getter)
    if ok then
        return value
    end
    return nil
end

local function devConsoleOpen(): boolean
    return safe(function()
        return StarterGui:GetCore("DevConsoleVisible")
    end) == true
end

local function isFocusTrap(box: any?): boolean
    if typeof(box) ~= "Instance" or not (box :: Instance):IsA("TextBox") then
        return false
    end
    local textBox = box :: TextBox
    if safe(function() return textBox.TextEditable end) == false then
        return true
    end
    if safe(function() return textBox.Visible end) == false then
        return true
    end
    local size = safe(function() return textBox.AbsoluteSize end)
    if typeof(size) == "Vector2" and size.X <= 4 and size.Y <= 4 then
        return true
    end
    return false
end

function Keyboard.IsTyping(): boolean
    if GuiService.MenuIsOpen or devConsoleOpen() then
        return false
    end
    local focused = safe(function()
        return UserInputService:GetFocusedTextBox()
    end)
    if isFocusTrap(focused) then
        return false
    end
    return focused ~= nil
end

function Keyboard.ReleaseTraps(): ()
    if wanted ~= nil and os.clock() < wantedUntil then
        return
    end
    local focused = safe(function()
        return UserInputService:GetFocusedTextBox()
    end)
    if isFocusTrap(focused) then
        pcall(function()
            (focused :: TextBox):ReleaseFocus()
        end)
    end
end

local function contains(box: TextBox, position: Vector3): boolean
    local ok, inside = pcall(function()
        if box.Visible == false then
            return false
        end
        local abs = box.AbsolutePosition
        local size = box.AbsoluteSize
        return position.X >= abs.X and position.X <= abs.X + size.X
            and position.Y >= abs.Y and position.Y <= abs.Y + size.Y
    end)
    return ok and inside == true
end

local function hitTest(position: Vector3): TextBox?
    local hit: TextBox? = nil
    for box in pairs(attached) do
        if contains(box, position) then
            hit = box
        end
    end
    return hit
end

local function focusTarget(target: TextBox): ()
    wanted = target
    wantedUntil = os.clock() + 4
    task.defer(function()
        if wanted ~= target then
            return
        end
        if GuiService.MenuIsOpen or devConsoleOpen() then
            return
        end
        local focused = safe(function()
            return UserInputService:GetFocusedTextBox()
        end)
        if focused == target then
            return
        end
        if focused ~= nil and not isFocusTrap(focused) then
            wanted = nil
            return
        end
        pcall(function()
            target:CaptureFocus()
        end)
    end)
end

local function claim(): ()
    local target = wanted
    if target == nil then
        return
    end
    if os.clock() > wantedUntil or target.Parent == nil or target.Visible == false then
        wanted = nil
        return
    end
    local focused = safe(function()
        return UserInputService:GetFocusedTextBox()
    end)
    if focused == target then
        return
    end
    if focused ~= nil and not isFocusTrap(focused) then
        wanted = nil
        return
    end
    if GuiService.MenuIsOpen or devConsoleOpen() then
        return
    end
    pcall(function()
        target:CaptureFocus()
    end)
end

local function onInput(input: InputObject): ()
    if input.UserInputType ~= Enum.UserInputType.MouseButton1
        and input.UserInputType ~= Enum.UserInputType.Touch
    then
        return
    end
    local hit = hitTest(input.Position)
    if hit ~= nil then
        focusTarget(hit)
    elseif wanted ~= nil and not contains(wanted, input.Position) then
        wanted = nil
    end
end

function Keyboard.AttachTextBox(box: any): ()
    if typeof(box) ~= "Instance" or not (box :: Instance):IsA("TextBox") then
        return
    end
    local textBox = box :: TextBox
    if attached[textBox] then
        return
    end
    attached[textBox] = true

    pcall(function()
        textBox.Selectable = true
        textBox.TextEditable = true
    end)

    textBox.InputBegan:Connect(function(input: InputObject)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch
        then
            focusTarget(textBox)
        end
    end)

    textBox.FocusLost:Connect(function(enterPressed: boolean)
        if enterPressed and wanted == textBox then
            wanted = nil
        end
    end)

    textBox.Destroying:Connect(function()
        if wanted == textBox then
            wanted = nil
        end
    end)
end

function Keyboard.Protect(root: Instance): ()
    if typeof(root) ~= "Instance" then
        return
    end
    for _, desc in ipairs((root :: Instance):GetDescendants()) do
        if desc:IsA("TextBox") then
            Keyboard.AttachTextBox(desc)
        end
    end
    (root :: Instance).DescendantAdded:Connect(function(desc: Instance)
        if desc:IsA("TextBox") then
            Keyboard.AttachTextBox(desc)
        end
    end)
end

if inputConn == nil then
    inputConn = UserInputService.InputBegan:Connect(onInput)
end
if renderConn == nil then
    renderConn = RunService.RenderStepped:Connect(claim)
end

local genv = (typeof(getgenv) == "function" and getgenv())
    or (typeof(_G) == "table" and _G)
    or {}
genv.GDH_Keyboard = Keyboard

return Keyboard

end
MODULES["src/Function/KeyPop.luau"] = function()
local RunService = game:GetService("RunService")
local TextService = game:GetService("TextService")

local genv = (typeof(getgenv) == "function" and getgenv())
    or (typeof(_G) == "table" and _G)
    or {}

local Import = genv.Import
if not Import then return end

local KeyPop = {}

type KeyPopOptions = {
    name: string?,
    hint: string?,
    parent: Instance?,
    side: string?,
    gap: number?,
    height: number?,
    font: Font?,
    color: Color3?,
}

local function textWidth(text: string, font: Font, size: number): number
    if typeof(text) ~= "string" or text == "" then
        return 0
    end
    local ok, bounds = pcall(function()
        return TextService:GetTextSize(text, size, font, Vector2.new(2000, 0))
    end)
    if ok and typeof(bounds) == "TextBounds" then
        return math.max(bounds.X, 0)
    end

    return math.max(size * 0.55 * #text, 0)
end

local function defaultFont(): Font
    local ok, face = pcall(function()
        return Import.Font("Assets/GD/PUSAB___.otf", "Pusab")
    end)
    if ok and face ~= nil then
        return face
    end
    return Font.fromEnum(Enum.Font.GothamBlack)
end

function KeyPop.Update(frame: Frame, parent: Instance, opts: KeyPopOptions?)
    if frame.Parent == nil or parent.Parent == nil then
        return
    end

    local px = parent.AbsolutePosition.X
    local py = parent.AbsolutePosition.Y
    local pw = parent.AbsoluteSize.X
    local ph = parent.AbsoluteSize.Y
    if pw <= 0 or ph <= 0 then
        return
    end

    local side = (opts and opts.side) or "right"
    local gap = math.max(0, (opts and typeof(opts.gap) == "number" and opts.gap) or 4)
    local fw = frame.Size.X.Offset
    local fh = frame.Size.Y.Offset

    local X, Y
    if side == "left" then
        X = px - fw - gap
        Y = py + ph / 2 - fh / 2
    elseif side == "top" then
        X = px + pw / 2 - fw / 2
        Y = py - fh - gap
    elseif side == "bottom" then
        X = px + pw / 2 - fw / 2
        Y = py + ph + gap
    else
        X = px + pw + gap
        Y = py + ph / 2 - fh / 2
    end

    frame.Position = UDim2.new(0, X - px, 0, Y - py)
end

function KeyPop.Create(parent: Instance, opts: KeyPopOptions): Frame?
    if not parent then
        return nil
    end

    local name = (typeof(opts.name) == "string" and opts.name ~= "" and opts.name)
        or parent.Name
        or ""
    local hint = typeof(opts.hint) == "string" and opts.hint or ""
    local side = opts.side or "right"
    local gap = math.max(0, typeof(opts.gap) == "number" and opts.gap or 4)
    local popHeight = math.max(14, typeof(opts.height) == "number" and opts.height or 26)
    local font = opts.font or defaultFont()

    local padX = 8
    local lineH = popHeight * 0.5
    local nameSize = popHeight * 0.7
    local hintSize = popHeight * 0.55

    local nameW = textWidth(name, font, nameSize)
    local hintW = textWidth(hint, font, hintSize)
    local width = math.max(nameW, hintW) + padX * 2

    local frame = Instance.new("Frame")
    frame.Name = "KeyPop"
    frame.AnchorPoint = Vector2.new(0, 0)
    frame.Size = UDim2.new(0, width, 0, popHeight)
    frame.BackgroundColor3 = opts.color or Color3.fromRGB(10, 10, 10)
    frame.BackgroundTransparency = 0.3
    frame.BorderSizePixel = 0
    frame.ZIndex = (parent.ZIndex or 0) + 3
    frame.Parent = parent

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = frame

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Name = "Name"
    nameLabel.AnchorPoint = Vector2.new(0.5, 0.5)
    nameLabel.Position = UDim2.new(0.5, 0, 0.5, 0)
    nameLabel.Size = UDim2.new(0.96, 0, lineH, 0)
    nameLabel.FontFace = font
    nameLabel.TextSize = nameSize
    nameLabel.Text = name
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.TextXAlignment = Enum.TextXAlignment.Center
    nameLabel.TextYAlignment = Enum.TextYAlignment.Center
    nameLabel.BackgroundTransparency = 1
    nameLabel.BorderSizePixel = 0
    nameLabel.Parent = frame

    local hintLabel = Instance.new("TextLabel")
    hintLabel.Name = "Hint"
    hintLabel.AnchorPoint = Vector2.new(0.5, 0.5)
    hintLabel.Position = UDim2.new(0.5, 0, 0.75, 0)
    hintLabel.Size = UDim2.new(0.96, 0, lineH * 0.8, 0)
    hintLabel.FontFace = font
    hintLabel.TextSize = hintSize
    hintLabel.Text = hint
    hintLabel.TextColor3 = Color3.fromRGB(210, 210, 210)
    hintLabel.TextXAlignment = Enum.TextXAlignment.Center
    hintLabel.TextYAlignment = Enum.TextYAlignment.Center
    hintLabel.BackgroundTransparency = 1
    hintLabel.BorderSizePixel = 0
    hintLabel.Parent = frame

    do
        local frames = 12
        local conn: RBXScriptConnection? = nil
        conn = RunService.RenderStepped:Connect(function()
            frames -= 1
            if frames <= 0 or frame.Parent == nil or parent.Parent == nil then
                if conn then
                    conn:Disconnect()
                end
                return
            end
            KeyPop.Update(frame, parent, opts)
        end)
    end

    KeyPop.Update(frame, parent, opts)
    return frame
end

return KeyPop

end
MODULES["src/Function/Popup_GD.luau"] = function()
local TweenService     = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService       = game:GetService("RunService")
local Players          = game:GetService("Players")

local genv = (typeof(getgenv) == "function" and getgenv())
    or (typeof(_G) == "table" and _G)
    or {}

local Import = genv.Import
if not Import then return {} end

local Popup_GD = {}

export type Style = {
    before: string?,
    highlight: string?,
    after: string?,
    line2: string?,
    color: string?,
    bold: boolean?,
    quote: boolean?,
    separator: string?,
}

export type PopupConfig = {
    Name: string?,
    Parent: Instance?,
    DisplayOrder: number?,
    Width: number?,
    Height: number?,
    Size: UDim2?,
    PanelWidth: number?,
    PanelHeight: number?,
    PanelSize: UDim2?,
    Title: string?,
    Body: string?,
    ButtonText: string?,
    Dim: number?,
    OnClose: (() -> ())?,
}

local DEFAULT_COLOR = "#66FF66"
local REFERENCE_X = 1920
local REFERENCE_Y = 1080
local MIN_FIT = 0.62

local function applyResponsive(panel: Instance?)
    if not panel then return end
    local responsive = panel:FindFirstChild("Responsive")
    if not responsive then return end
    local camera = workspace.CurrentCamera
    local vp = camera and camera.ViewportSize or Vector2.new(REFERENCE_X, REFERENCE_Y)
    local designW = panel:GetAttribute("GDHDesignW") or REFERENCE_X * 0.34
    local designH = panel:GetAttribute("GDHDesignH") or REFERENCE_Y * 0.40
    local fit = math.clamp(math.min(vp.X / REFERENCE_X, vp.Y / REFERENCE_Y), MIN_FIT, 1.35)
    fit = math.min(fit, (vp.X - 40) / math.max(designW, 1), (vp.Y - 40) / math.max(designH, 1))
    responsive.Scale = math.max(fit, 0.25)
end

function Popup_GD.Text(style: Style | string, ...): string
    local args = table.pack(...)

    if typeof(style) == "string" then
        if args.n == 0 or string.find(style, "<", 1, true) ~= nil then
            return style
        end
    end

    local o: Style
    if typeof(style) == "table" then
        o = style
    else
        o = {
            before    = if typeof(style) == "string" then style else "",
            highlight = if typeof(args[1]) == "string" then args[1] else nil,
            after     = if typeof(args[2]) == "string" then args[2] else nil,
            line2     = if typeof(args[3]) == "string" then args[3] else nil,
            color     = if typeof(args[4]) == "string" then args[4] else nil,
        }
    end

    local before = if typeof(o.before) == "string" then o.before else ""
    local word = if typeof(o.highlight) == "string" then o.highlight else ""
    local afterText = if typeof(o.after) == "string" then o.after else ""
    local secondLine = if typeof(o.line2) == "string" then o.line2 else ""
    local textColor = if typeof(o.color) == "string" then o.color else DEFAULT_COLOR
    local bold = if typeof(o.bold) == "boolean" then o.bold else true
    local quote = if typeof(o.quote) == "boolean" then o.quote else true
    local separator = if typeof(o.separator) == "string" then o.separator else "\n"

    local shown = if quote then ('"' .. word .. '"') else word
    if bold then
        shown = "<b>" .. shown .. "</b>"
    end

    local result = before .. '<font color="' .. textColor .. '">' .. shown .. "</font>" .. afterText
    if secondLine ~= "" then
        result ..= separator .. secondLine
    end
    return result
end

Popup_GD.Format = Popup_GD.Text

local fontPusab: Font = Font.fromEnum(Enum.Font.GothamBlack)
do
