    end
    return nil
end

local function markCoin(layer, id)
    local level = layer and layer.level
    if type(level) ~= "table" then
        return
    end
    local coinNo = nil
    local native = level.native
    if type(native) == "table" and type(native.coinIndex) == "table" then
        coinNo = native.coinIndex[id]
    end
    if coinNo == nil and type(level._userCoinIndex) == "table" then
        coinNo = level._userCoinIndex[id]
    end

    local runtime = getRuntime()
    local state = runtime and runtime.layer and runtime.layer.state or layer.state
    local endSystem = level._endSystem
        or (runtime and runtime.layer and runtime.layer.ending)
        or layer.ending
    if type(state) ~= "table" then
        return
    end
    if type(state._collected) ~= "table" then
        state._collected = {}
    end
    if not state._collected[id] then
        state._collected[id] = true
        state.coins = (state.coins or 0) + 1
    end
    if type(state.collectedCoins) ~= "table" then
        state.collectedCoins = {}
    end
    if type(coinNo) == "number" and coinNo >= 1 and coinNo <= 3 then
        state.collectedCoins[tostring(coinNo)] = true
        if type(endSystem) == "table" and type(endSystem.runCoins) == "table" then
            endSystem.runCoins[coinNo] = true
        end
    end
end

local function wrapper(original, self, source, id, ...)
    local level = self and self.level
    local objectType = self and type(self.N) == "table" and type(self.N.type) == "table"
        and self.N.type[id] or nil
    if not enabled or level == nil or level.practice ~= true
        or (objectType ~= 22 and objectType ~= 31) then
        return original(self, source, id, ...)
    end
    local practice = level.practice
    level.practice = false
    local results = table.pack(pcall(original, self, source, id, ...))
    level.practice = practice
    if results[1] then
        pcall(markCoin, self, id)
        return table.unpack(results, 2, results.n)
    end
    error(results[2])
end

function CoinsInPractice.Set(state)
    enabled = state == true
    if not hook then
        return
    end
    if enabled then
        hook:Wrap("LogicRuntime", "collect", wrapper)
    else
        hook:Restore()
    end
end

function CoinsInPractice.IsEnabled()
    return enabled
end

function CoinsInPractice.Setup(window)
    window:AddToggle({
        Name = "Coins In Practice",
        Default = false,
        Description = "Count coins collected in practice mode",
        Cheating = true,
        Callback = function(state)
            CoinsInPractice.Set(state)
        end,
    })
end

return CoinsInPractice

end
MODULES["Script/Geometry Dash 2.2/Features/Level/ConfirmExit.luau"] = function()
local genv = (typeof(getgenv) == "function" and getgenv())
    or (typeof(_G) == "table" and _G)
    or {}

local ConfirmExit = {}
local enabled = false
local original = nil

local function getRuntime()
    local ok, mod = pcall(function()
        local port = game:GetService("ReplicatedStorage"):FindFirstChild("GDPort")
        local rt = port and port:FindFirstChild("ClientRuntime")
        return rt and require(rt) or nil
    end)
    if ok and type(mod) == "table" then
        return mod
    end
    return nil
end

local function getView(runtime, create)
    local screens = runtime and runtime.MenuScreens
    local view = screens and screens.views and screens.views.options
    if view ~= nil and not view.destroyed and not view.closed then
        return view, false
    end
    if create and type(runtime.showOptions) == "function" then
        pcall(runtime.showOptions)
        view = screens and screens.views and screens.views.options
        if view ~= nil and not view.destroyed and not view.closed then
            return view, true
        end
    end
    return nil, false
end

local function apply(value)
    local runtime = getRuntime()
    if runtime == nil then
        return
    end
    local view, created = getView(runtime, true)
    if view == nil then
        return
    end
    if type(view.values) == "table" and type(view.values.confirmExit) == "boolean" then
        view.values.confirmExit = value
    end
    pcall(function()
        if type(view.options) == "table" and type(view.options.set) == "function" then
            view.options.set("confirmExit", value)
        end
        if type(view.setValue) == "function" then
            view:setValue("confirmExit", value)
        end
    end)
    if created then
        pcall(function()
            view:close()
        end)
    end
end

function ConfirmExit.Set(state)
    local nextEnabled = state == true
    if nextEnabled and not enabled then
        local runtime = getRuntime()
        local view, created = getView(runtime, true)
        if view ~= nil and type(view.values) == "table"
            and type(view.values.confirmExit) == "boolean" then
            original = view.values.confirmExit
        end
        if created then
            pcall(function()
                view:close()
            end)
        end
        apply(true)
    elseif not nextEnabled and enabled then
        apply(original == true)
        original = nil
    end
    enabled = nextEnabled
end

function ConfirmExit.IsEnabled()
    return enabled
end

function ConfirmExit.Setup(window)
    window:AddToggle({
        Name = "Confirm Exit",
        Default = false,
        Description = "Always require confirmation before exiting a level",
        Callback = function(state)
            ConfirmExit.Set(state)
        end,
    })
end

return ConfirmExit

end
MODULES["Script/Geometry Dash 2.2/Features/Level/GamepassUtil.luau"] = function()
local RunService = game:GetService("RunService")

local GamepassUtil = {}

local KEYS = {
    noclip = "noclip",
    menu = "menu",
    speed = "speed",
}

local states = {
    noclip = { enabled = false, saved = nil },
    menu = { enabled = false, saved = nil },
    speed = { enabled = false, saved = nil },
}

local runtime = nil
local watchConn = nil
local appliedHacks = nil
local newHacksWrapped = false

local function getRuntime()
    if runtime then
        return runtime
    end
    local ok, mod = pcall(function()
        local port = game:GetService("ReplicatedStorage"):FindFirstChild("GDPort")
        local rt = port and port:FindFirstChild("ClientRuntime")
        return rt and require(rt) or nil
    end)
    if ok and type(mod) == "table" then
        runtime = mod
    end
    return runtime
end

local function changed(hacks)
    if type(hacks) ~= "table" or type(hacks._changed) ~= "function" then
        return
    end
    pcall(function()
        hacks:_changed()
    end)
end

local function apply(key)
    local state = states[key]
    local hacks = getRuntime()
    hacks = hacks and hacks.hacks
    if not state or type(hacks) ~= "table" or type(hacks.owned) ~= "table" then
        return
    end
    if type(hacks.known) ~= "table" then
        hacks.known = {}
    end

    if state.enabled then
        if state.saved and state.saved.hacks ~= hacks then
            state.saved = nil
        end
        if not state.saved then
            state.saved = {
                hacks = hacks,
                owned = hacks.owned[key],
                known = hacks.known[key],
                noclip = hacks.noclip,
            }
        end
        hacks.owned[key] = true
        hacks.known[key] = true
        if key == "noclip" then
            hacks.noclip = true
        end
    elseif state.saved and state.saved.hacks == hacks then
        if state.saved.owned == nil then
            hacks.owned[key] = nil
        else
            hacks.owned[key] = state.saved.owned
        end
        if state.saved.known == nil then
            hacks.known[key] = nil
        else
            hacks.known[key] = state.saved.known
        end
        if key == "noclip" then
            hacks.noclip = state.saved.noclip
        end
        state.saved = nil
    else
        return
    end

    changed(hacks)
end

local function applyEnabled(hacks)
    appliedHacks = hacks
    for key, state in pairs(states) do
        if state.enabled then
            apply(key)
        end
    end
end

local function tick()
    local rt = getRuntime()
    local hacks = rt and rt.hacks
    if hacks ~= appliedHacks then
        applyEnabled(hacks)
    end
end

local function watch()
    if watchConn then
        return
    end
    watchConn = RunService.Heartbeat:Connect(tick)

    local rt = getRuntime()
    if not rt or newHacksWrapped or type(rt.newHacks) ~= "function" then
        return
    end
    local original = rt.newHacks
    rt.newHacks = function(...)
        local hacks = original(...)
        task.spawn(function()
            applyEnabled(hacks)
        end)
        return hacks
    end
    newHacksWrapped = true
end

function GamepassUtil.Set(name, state)
    local key = KEYS[name]
    if not key then
        return false
    end
    states[key].enabled = state == true
    watch()
    apply(key)
    return states[key].enabled
end

function GamepassUtil.IsEnabled(name)
    local key = KEYS[name]
    return key ~= nil and states[key].enabled
end

return GamepassUtil

end
MODULES["Script/Geometry Dash 2.2/Features/Level/HitboxMultiplier.luau"] = function()
local RunService = game:GetService("RunService")

local genv = (typeof(getgenv) == "function" and getgenv())
    or (typeof(_G) == "table" and _G)
    or {}

local okUtil, Util = pcall(function()
    return genv.Import("Geometry Dash 2.2/Features/Level/Util")
end)
if not okUtil or type(Util) ~= "table" then
    Util = nil
end

local HitboxMultiplier = {}
local enabled = false
local hook = Util and Util.NewHook() or nil
local watcher = nil
local activePass = nil
local saved = {}
local multipliers = { player = 1, solid = 1, hazard = 1 }

local function getRuntime()
    local ok, mod = pcall(function()
        local port = game:GetService("ReplicatedStorage"):FindFirstChild("GDPort")
        local rt = port and port:FindFirstChild("ClientRuntime")
        return rt and require(rt) or nil
    end)
    if ok and type(mod) == "table" then
        return mod
    end
    return nil
end

local function numberSetting(key, default)
    local store = genv.GDH_HACK_SETTINGS_STATE
    local state = type(store) == "table" and store["hitbox multiplier"] or nil
    local value = type(state) == "table" and state[key] or nil
    if type(value) == "number" then
        return value
    end
    return default
end

local function readSettings()
    return {
        player = math.clamp(numberSetting("player_multiplier", 1), 0, 10),
        solid = math.clamp(numberSetting("solid_multiplier", 1), 0, 10),
        hazard = math.clamp(numberSetting("hazard_multiplier", 1), 0, 10),
    }
end

local function sameSettings(a, b)
    return a.player == b.player and a.solid == b.solid and a.hazard == b.hazard
end

local function scaleBox(box, scale)
    if type(box) ~= "table" or scale == 1 then
        return box
    end
    local result = {}
    for key, value in pairs(box) do
        result[key] = value
    end
    local cx = (tonumber(box.x0) + tonumber(box.x1) + tonumber(box.x2) + tonumber(box.x3)) / 4
    local cy = (tonumber(box.y0) + tonumber(box.y1) + tonumber(box.y2) + tonumber(box.y3)) / 4
    for index = 0, 3 do
        local xKey, yKey = "x" .. index, "y" .. index
        result[xKey] = cx + ((tonumber(box[xKey]) or cx) - cx) * scale
        result[yKey] = cy + ((tonumber(box[yKey]) or cy) - cy) * scale
    end
    result.oa = (tonumber(box.oa) or 0) * scale
    result.ob = (tonumber(box.ob) or 0) * scale
    return result
end

local function getPass()
    local runtime = getRuntime()
    return runtime and runtime.layer and runtime.layer.pass or nil
end

local function restoreObjects()
    if type(activePass) ~= "table" then
        return
    end
    local pass = activePass
    for id, entry in pairs(saved) do
        rawset(pass.oW, id, entry.w)
        rawset(pass.oH, id, entry.h)
        rawset(pass.oRad, id, entry.rad)
        if type(pass.store) == "table" and type(pass.store.rectDirty) == "table" then
            pass.store.rectDirty[id] = true
        end
    end
    table.clear(saved)
    activePass = nil
end

local function applyObjects()
    local pass = getPass()
    if type(pass) ~= "table" or type(pass.oW) ~= "table" or type(pass.oH) ~= "table" then
        return
    end
    if activePass ~= pass then
        restoreObjects()
        activePass = pass
    end
    for id in pairs(pass.oType or {}) do
        if saved[id] == nil then
            saved[id] = {
                w = rawget(pass.oW, id),
                h = rawget(pass.oH, id),
                rad = type(pass.oRad) == "table" and rawget(pass.oRad, id) or nil,
            }
        end
        local hazard = pass.oType[id] == 2 or pass.oType[id] == 47
        local kind = hazard and multipliers.hazard or multipliers.solid
        local baseW = tonumber(saved[id].w) or tonumber(pass.cW and pass.cW[id]) or 0
        local baseH = tonumber(saved[id].h) or tonumber(pass.cH and pass.cH[id]) or 0
        if baseW > 0 or baseH > 0 then
            rawset(pass.oW, id, baseW * kind)
            rawset(pass.oH, id, baseH * kind)
            if type(pass.oRad) == "table" then
                local baseRad = tonumber(saved[id].rad)
                    or tonumber(pass.cRad and pass.cRad[id]) or 0
                if baseRad > 0 then
                    rawset(pass.oRad, id, baseRad * kind)
                end
            end
            if type(pass.store) == "table" and type(pass.store.rectDirty) == "table" then
                pass.store.rectDirty[id] = true
            end
            pcall(function()
                pass:objectRect(id)
            end)
        end
    end
end

local function restore()
    if hook then
        hook:Restore()
    end
    restoreObjects()
end

local function apply()
    restore()
    if not enabled or not hook then
        return
    end
    hook:Wrap("Player", "getRect", function(original, self, ...)
        local x, y, width, height = original(self, ...)
        return x, y, width * multipliers.player, height * multipliers.player
    end)
    hook:Wrap("CollisionPass", "playerOBB", function(original, self, player, ...)
        return scaleBox(original(self, player, ...), multipliers.player)
    end)
    applyObjects()
end

local function watch()
    if watcher then
        return
    end
    watcher = RunService.Heartbeat:Connect(function()
        if not enabled then
            return
        end
        local wanted = readSettings()
        if not sameSettings(wanted, multipliers) or getPass() ~= activePass then
            multipliers = wanted
            apply()
        end
    end)
end

function HitboxMultiplier.Set(state)
    enabled = state == true
    multipliers = readSettings()
    apply()
    if enabled then
        watch()
    elseif watcher then
        watcher:Disconnect()
        watcher = nil
    end
end

function HitboxMultiplier.IsEnabled()
    return enabled
end

function HitboxMultiplier.Setup(window)
    window:AddToggle({
        Name = "Hitbox Multiplier",
        Default = false,
        Description = "Scale player, solid and hazard hitboxes",
        Cheating = true,
        Settings = {
            { Kind = "Float", Text = "Player Multiplier", Key = "player_multiplier", Min = 0, Max = 10, Default = 1, Increment = 0.05, Precision = 2, Suffix = "x" },
            { Kind = "Float", Text = "Solid Multiplier", Key = "solid_multiplier", Min = 0, Max = 10, Default = 1, Increment = 0.05, Precision = 2, Suffix = "x" },
            { Kind = "Float", Text = "Hazard Multiplier", Key = "hazard_multiplier", Min = 0, Max = 10, Default = 1, Increment = 0.05, Precision = 2, Suffix = "x" },
        },
        Callback = function(state)
            HitboxMultiplier.Set(state)
        end,
    })
end

return HitboxMultiplier

end
MODULES["Script/Geometry Dash 2.2/Features/Level/IgnoreESC.luau"] = function()
