            if buttonImage ~= "" and okBtnImage.Parent then
                okBtnImage.Image = buttonImage
                okBtnImage.BackgroundTransparency = 1
            end
        end)
    end

    local okLabel = Instance.new("TextLabel")
    okLabel.Name = "Label"
    okLabel.BackgroundTransparency = 1
    okLabel.BorderSizePixel = 0
    okLabel.AnchorPoint = Vector2.new(0.5, 0.5)
    okLabel.Position = UDim2.new(0.5, 0, 0.5, 5)
    okLabel.Size = UDim2.new(1, -60, 1, -45)
    okLabel.FontFace = fontPusab
    okLabel.Text = buttonText
    okLabel.TextScaled = true
    okLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    okLabel.TextXAlignment = Enum.TextXAlignment.Center
    okLabel.TextYAlignment = Enum.TextYAlignment.Bottom
    okLabel.ZIndex = 5
    okLabel.Parent = okBtnImage

    local okStroke = Instance.new("UIStroke")
    okStroke.Color = Color3.new(0, 0, 0)
    okStroke.Thickness = 3
    okStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
    okStroke.Parent = okLabel

    local okGradient = Instance.new("UIGradient")
    okGradient.Rotation = titleGradient.Rotation
    okGradient.Color = titleGradient.Color
    okGradient.Parent = okLabel

    local BODY_GAP = 10
    local held = false
    local layoutHold = false
    local lastOkTopScale: number? = nil

    local function layoutBody()
        local panelSize = panel.AbsoluteSize
        if panelSize.X <= 0 or panelSize.Y <= 0 then return end
        local panelPos = panel.AbsolutePosition
        local titleBottom = title.AbsolutePosition.Y - panelPos.Y + title.AbsoluteSize.Y
        local okTop
        if layoutHold and lastOkTopScale ~= nil then
            okTop = lastOkTopScale * panelSize.Y
        else
            okTop = okBtnImage.AbsolutePosition.Y - panelPos.Y
            lastOkTopScale = okTop / panelSize.Y
        end
        local topScale = (titleBottom + BODY_GAP) / panelSize.Y
        local bottomScale = (okTop - BODY_GAP) / panelSize.Y
        if bottomScale <= topScale + 0.05 then return end
        body.Position = UDim2.new(0.5, 0, topScale, 0)
        body.Size = UDim2.new(0.86, 0, bottomScale - topScale, 0)
    end

    task.defer(layoutBody)

    local layoutConn: RBXScriptConnection? = nil
    layoutConn = RunService.RenderStepped:Connect(function()
        if screen.Parent == nil then
            if layoutConn then layoutConn:Disconnect() end
            return
        end
        layoutBody()
    end)
    screen.Destroying:Connect(function()
        if layoutConn then layoutConn:Disconnect() end
        if resizeConn then resizeConn:Disconnect() end

        for _, t in tweenRefs do
            pcall(function() t:Cancel() end)
        end
        table.clear(tweenRefs)
    end)

    local baseResponsiveScale = responsive.Scale
    responsive.Scale = baseResponsiveScale * 0.5
    screen.Parent = playerGui

    local openScaleTween = TweenService:Create(responsive,
        TweenInfo.new(0.8, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out),
        { Scale = baseResponsiveScale }
    )
    table.insert(tweenRefs, openScaleTween)
    openScaleTween.Completed:Connect(function(state)
        if state == Enum.PlaybackState.Completed then
            applyResponsive(panel)
        end
    end)
    openScaleTween:Play()

    overlay.BackgroundTransparency = 1
    local overlayTween = TweenService:Create(overlay,
        TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { BackgroundTransparency = dim }
    )
    table.insert(tweenRefs, overlayTween)
    overlayTween:Play()

    local okScale = Instance.new("UIScale")
    okScale.Scale = 0.85
    okScale.Parent = okBtnImage

    local okLabelScale = Instance.new("UIScale")
    okLabelScale.Scale = 0.85
    okLabelScale.Parent = okLabel

    local okPopTween = TweenService:Create(okScale,
        TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        { Scale = 1 }
    )
    table.insert(tweenRefs, okPopTween)
    okPopTween:Play()
    local okLabelTween = TweenService:Create(okLabelScale,
        TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        { Scale = 1 }
    )
    table.insert(tweenRefs, okLabelTween)
    okLabelTween:Play()

    local closing = false
    local function close()
        if closing then return end
        closing = true
        screen:Destroy()
        if typeof(cfg.OnClose) == "function" then
            pcall(cfg.OnClose)
        end
    end
    okBtnImage.Activated:Connect(close)

    local pressScale = okScale
    local basePos = okBtnImage.Position
    local pivotX = okBtnImage.AnchorPoint.X - 0.5
    local pivotY = okBtnImage.AnchorPoint.Y - 0.5
    local sizeXScale = okBtnImage.Size.X.Scale
    local sizeXOffset = okBtnImage.Size.X.Offset
    local sizeYScale = okBtnImage.Size.Y.Scale
    local sizeYOffset = okBtnImage.Size.Y.Offset

    local function posComp(value: number): UDim2
        local f = value - 1
        return UDim2.new(
            f * sizeXScale * pivotX,
            f * sizeXOffset * pivotX,
            f * sizeYScale * pivotY,
            f * sizeYOffset * pivotY
        )
    end

    local activePressTweens: { Tween } = {}

    local function stopPressTweens()
        for _, t in activePressTweens do
            pcall(function() t:Cancel() end)
        end
        table.clear(activePressTweens)
    end

    local function press()
        if held then return end
        held = true
        layoutHold = true
        pcall(function() okPopTween:Cancel() end)
        stopPressTweens()
        pressScale.Scale = 1
        okBtnImage.Position = basePos

        table.insert(activePressTweens, TweenService:Create(pressScale,
            TweenInfo.new(0.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
            { Scale = 1.14 }
        ))
        table.insert(activePressTweens, TweenService:Create(okBtnImage,
            TweenInfo.new(0.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
            { Position = basePos + posComp(1.14) }
        ))
        for _, t in activePressTweens do t:Play() end
    end

    local function releasePress()
        if not held then return end
        held = false
        stopPressTweens()

        local backScale = TweenService:Create(pressScale,
            TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
            { Scale = 1 }
        )
        table.insert(activePressTweens, backScale)
        table.insert(activePressTweens, TweenService:Create(okBtnImage,
            TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
            { Position = basePos }
        ))
        for _, t in activePressTweens do t:Play() end
        backScale.Completed:Connect(function(state)
            if state == Enum.PlaybackState.Completed then
                pressScale.Scale = 1
                okBtnImage.Position = basePos
                layoutHold = false
                task.defer(layoutBody)
            end
        end)
    end

    local function isClick(input: InputObject): boolean
        return input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch
    end

    okBtnImage.InputBegan:Connect(function(input)
        if isClick(input) then press() end
    end)
    okBtnImage.InputEnded:Connect(function(input)
        if isClick(input) then releasePress() end
    end)
    okBtnImage.MouseLeave:Connect(releasePress)
    UserInputService.InputEnded:Connect(function(input)
        if isClick(input) then releasePress() end
    end)

    return screen
end

function Popup_GD.Root(gui: Instance?): Instance?
    if not gui then return nil end
    return gui:FindFirstChild("Root")
end

function Popup_GD.Panel(gui: Instance?): Instance?
    local root = Popup_GD.Root(gui)
    if not root then return nil end
    return root:FindFirstChild("Panel")
end

local function setDesignSize(panel: Instance?, designW: number, designH: number)
    if not panel then return end
    panel:SetAttribute("GDHDesignW", designW)
    panel:SetAttribute("GDHDesignH", designH)
    panel.Size = UDim2.fromOffset(designW, designH)
    applyResponsive(panel)
end

function Popup_GD.SetPanelSize(gui: Instance?, size: UDim2)
    local panel = Popup_GD.Panel(gui)
    local w = size.X.Scale * REFERENCE_X + size.X.Offset
    local h = size.Y.Scale * REFERENCE_Y + size.Y.Offset
    setDesignSize(panel, w, h)
end

function Popup_GD.SetPanelScale(gui: Instance?, scaleX: number, scaleY: number?)
    local panel = Popup_GD.Panel(gui)
    local h = if typeof(scaleY) == "number"
        then scaleY * REFERENCE_Y
        else (panel and panel:GetAttribute("GDHDesignH") or REFERENCE_Y * 0.40)
    setDesignSize(panel, scaleX * REFERENCE_X, h)
end

Popup_GD.Show = Popup_GD.Create

return Popup_GD

end
MODULES["src/Function/Save.luau"] = function()
local HttpService = game:GetService("HttpService")

local Save: any = {}

local SAVE_EXTENSION = ".json"
local COMMIT_DELAY = 0.4

local genv = (typeof(getgenv) == "function" and getgenv())
    or (typeof(_G) == "table" and _G)
    or {}

local function importSibling(name: string): any
    local Import = genv.Import
    if Import then
        local module = Import("Function/" .. name)
        if module ~= nil then
            return module
        end
    end
    return require(script.Parent[name])
end

local Storage = importSibling("Storage")

local SCALAR_SECTIONS: { [string]: string } = {
    Toggles = "boolean",
    Sliders = "number",
    Radios = "boolean",
    Dropdowns = "string",
    Inputs = "number",
    Texts = "string",
}

local stores: { [string]: any } = {
    Global = {
        Scope = "Global",
        Subpath = "",
        FileName = "Global" .. SAVE_EXTENSION,
        FsDir = "GDH",
    },
    Map = {
        Scope = "Map",
        Subpath = "Saves",
        FileName = tostring(game.PlaceId) .. SAVE_EXTENSION,
        FsDir = "GDH/Saves",
    },
}

local function storeOf(scope: any): any
    if scope == "Global" then
        return stores.Global
    end
    return stores.Map
end

local function blankData(): { any }
    local data: { any } = {
        Place = {
            Id = game.PlaceId,
            Name = game.Name,
        },
        Keybinds = {
            Hacks = {},
            Actions = {},
            ToggleUI = nil,
            Custom = {},
        },
    }
    for section in SCALAR_SECTIONS do
        data[section] = {}
    end
    return data
end

local storeData: { [string]: { any } } = {}
local dataReady = false
local commitToken = 0

local function decodeJson(text: string): any?
    if typeof(text) ~= "string" or text == "" then
        return nil
    end
    local ok, decoded = pcall(function()
        return HttpService:JSONDecode(text)
    end)
    if ok and typeof(decoded) == "table" then
        return decoded
    end
    return nil
end

local function readStoredText(store: any): string?
    if typeof(Storage) == "table" and typeof(Storage.Read) == "function" then
        local ok, text = pcall(function()
            return Storage:Read(store.Subpath, store.FileName)
        end)
        if ok and typeof(text) == "string" and text ~= "" then
            return text :: string
        end
    end
    if typeof(readfile) == "function" and typeof(isfile) == "function" then
        local filePath = store.FsDir .. "/" .. store.FileName
        local okIs, exists = pcall(function()
            return (isfile :: any)(filePath)
        end)
        if okIs and exists == true then
            local okRead, content = pcall(readfile, filePath)
            if okRead and typeof(content) == "string" then
                return content
            end
        end
    end
    return nil
end

local function normalizeBind(value: any): any?
    if typeof(value) ~= "table" then
        return nil
    end
    local key = (value :: { any }).Key
    if typeof(key) ~= "EnumItem" then
        return nil
    end
    local mods: { string } = {}
    local rawMods = (value :: { any }).Mods
    if typeof(rawMods) == "table" then
        for _, mod in rawMods :: { any } do
            if typeof(mod) == "string" and mod ~= "" then
                table.insert(mods, mod :: string)
            end
        end
    end
    return { Key = key :: Enum.KeyCode, Mods = mods }
end

local function bindFromJson(value: any): any?
    if typeof(value) ~= "table" then
        return nil
    end
    local keyName = (value :: { any }).Key
    if typeof(keyName) ~= "string" or keyName == "" then
        return nil
    end
    local keyCode: any = nil
    pcall(function()
        keyCode = Enum.KeyCode[keyName :: string]
    end)
    if keyCode == nil then
        return nil
    end
    return normalizeBind({ Key = keyCode, Mods = (value :: { any }).Mods })
end

local function bindToJson(value: any): any?
    if typeof(value) ~= "table" then
        return nil
    end
    local key = (value :: { any }).Key
    if typeof(key) ~= "EnumItem" then
        return nil
    end
    local mods: { string } = {}
    local rawMods = (value :: { any }).Mods
    if typeof(rawMods) == "table" then
        for _, mod in rawMods :: { any } do
            if typeof(mod) == "string" and mod ~= "" then
                table.insert(mods, mod :: string)
            end
        end
    end
    return { Key = (key :: EnumItem).Name, Mods = mods }
end

local function loadData(store: any)
    local data = storeData[store.Scope]
    local text = readStoredText(store)
    if text == nil then
        return
    end
    local loaded = decodeJson(text :: string)
    if loaded == nil then
        return
    end
    for section, wantType in SCALAR_SECTIONS do
        local sectionData = loaded[section]
        if typeof(sectionData) == "table" then
            for key, value in sectionData :: { any } do
                if typeof(key) == "string" and typeof(value) == wantType then
                    data[section][key] = value
                end
            end
        end
    end
    local keybinds = loaded.Keybinds
    if typeof(keybinds) ~= "table" then
        return
    end
    local hacks = (keybinds :: { any }).Hacks
    if typeof(hacks) == "table" then
        for key, bind in hacks :: { any } do
            if typeof(key) == "string" then
                local clean = bindFromJson(bind)
                if clean ~= nil then
                    data.Keybinds.Hacks[key] = clean
                end
            end
        end
    end
    local actions = (keybinds :: { any }).Actions
    if typeof(actions) == "table" then
        for key, bind in actions :: { any } do
            if typeof(key) == "string" then
                local clean = bindFromJson(bind)
                if clean ~= nil then
                    data.Keybinds.Actions[key] = clean
                end
            end
        end
    end
    local custom = (keybinds :: { any }).Custom
    if typeof(custom) == "table" then
        for key, bind in custom :: { any } do
            if typeof(key) == "string" then
                local clean = bindFromJson(bind)
                if clean ~= nil then
                    data.Keybinds.Custom[key] = clean
                end
            end
        end
    end
    local cleanUI = bindFromJson((keybinds :: { any }).ToggleUI)
    if cleanUI ~= nil then
        data.Keybinds.ToggleUI = cleanUI
    end
end

for _, store in stores do
    storeData[store.Scope] = blankData()
end
for _, store in stores do
    loadData(store)
end
dataReady = true

local function ensureFsDirectory(fsDir: string)
    if typeof(makefolder) ~= "function" or typeof(isfolder) ~= "function" then
        return
    end
    local parts = string.split(fsDir, "/")
    local current = ""
    for _, part in parts do
        current = if current == "" then part else current .. "/" .. part
        local okIs, isDir = pcall(function()
            return (isfolder :: any)(current)
        end)
        if not okIs or isDir ~= true then
            pcall(makefolder, current)
        end
    end
end

local function commitStore(store: any)
    local data = storeData[store.Scope]
    local payload: { any } = {
        Place = {
            Id = game.PlaceId,
            Name = game.Name,
        },
    }
    for section, wantType in SCALAR_SECTIONS do
        local out: { any } = {}
        for key, value in data[section] :: { any } do
            if typeof(key) == "string" and typeof(value) == wantType then
                out[key] = value
            end
        end
        payload[section] = out
    end
    local binds: { any } = {
        Hacks = {},
        Actions = {},
        ToggleUI = nil,
        Custom = {},
    }
    for key, bind in data.Keybinds.Hacks :: { any } do
        local clean = bindToJson(bind)
        if typeof(key) == "string" and clean ~= nil then
            binds.Hacks[key] = clean
        end
    end
    for key, bind in data.Keybinds.Actions :: { any } do
        local clean = bindToJson(bind)
        if typeof(key) == "string" and clean ~= nil then
            binds.Actions[key] = clean
        end
    end
    for key, bind in data.Keybinds.Custom :: { any } do
        local clean = bindToJson(bind)
        if typeof(key) == "string" and clean ~= nil then
            binds.Custom[key] = clean
        end
    end
    binds.ToggleUI = bindToJson(data.Keybinds.ToggleUI)
    payload.Keybinds = binds
    local okEncode, text = pcall(function()
        return HttpService:JSONEncode(payload)
    end)
    if not okEncode or typeof(text) ~= "string" then
        return
    end
    if typeof(Storage) == "table" and typeof(Storage.Write) == "function" then
        pcall(function()
            Storage:Write(store.Subpath, store.FileName, text :: string)
        end)
    end
    if typeof(writefile) == "function" then
        ensureFsDirectory(store.FsDir)
        pcall(writefile, store.FsDir .. "/" .. store.FileName, text :: string)
    end
end

local function commitAll()
    if not dataReady then
        return
    end
    for _, store in stores do
        commitStore(store)
    end
end

local function scheduleCommit()
    if not dataReady then
        return
    end
    commitToken += 1
    local token = commitToken
    task.delay(COMMIT_DELAY, function()
        if token ~= commitToken then
            return
        end
        commitAll()
    end)
end

local function sectionOf(scope: any, section: string): { any }
    local data = storeData[storeOf(scope).Scope]
    local target = data[section]
    if typeof(target) ~= "table" then
        return {}
    end
    return target :: { any }
end

local function setScalar(scope: any, section: string, key: any, value: any)
    if typeof(key) ~= "string" or key == "" then
        return
    end
    sectionOf(scope, section)[key] = value
    scheduleCommit()
end

local function scalarOf(scope: any, section: string, key: any): any
    if typeof(key) ~= "string" then
        return nil
    end
    return sectionOf(scope, section)[key]
end

local function bindsOf(scope: any): { any }
    local data = storeData[storeOf(scope).Scope]
    return data.Keybinds :: { any }
end

function Save.SetToggle(key: string, state: boolean, scope: any?)
    setScalar(scope, "Toggles", key, state == true)
end

function Save.ToggleState(key: string, scope: any?): boolean?
    local value = scalarOf(scope, "Toggles", key)
    if typeof(value) ~= "boolean" then
        return nil
    end
    return value :: boolean
end

function Save.SetSlider(key: string, value: number, scope: any?)
    if typeof(value) ~= "number" then
        return
    end
    setScalar(scope, "Sliders", key, value)
end

function Save.SliderValue(key: string, scope: any?): number?
    local value = scalarOf(scope, "Sliders", key)
    if typeof(value) ~= "number" then
        return nil
    end
    return value :: number
end

function Save.SetRadio(key: string, active: boolean, scope: any?)
    setScalar(scope, "Radios", key, active == true)
end

function Save.RadioActive(key: string, scope: any?): boolean?
    local value = scalarOf(scope, "Radios", key)
    if typeof(value) ~= "boolean" then
        return nil
    end
    return value :: boolean
end

function Save.SetDropdown(key: string, value: any, scope: any?)
    if typeof(value) ~= "string" then
        return
    end
    setScalar(scope, "Dropdowns", key, value)
end

function Save.DropdownValue(key: string, scope: any?): string?
    local value = scalarOf(scope, "Dropdowns", key)
    if typeof(value) ~= "string" then
        return nil
    end
    return value :: string
end

function Save.SetInput(key: string, value: number, scope: any?)
    if typeof(value) ~= "number" then
        return
    end
    setScalar(scope, "Inputs", key, value)
end

function Save.InputValue(key: string, scope: any?): number?
    local value = scalarOf(scope, "Inputs", key)
    if typeof(value) ~= "number" then
        return nil
    end
    return value :: number
end

function Save.SetText(key: string, value: any, scope: any?)
    if typeof(value) ~= "string" then
        return
    end
    setScalar(scope, "Texts", key, value)
end

function Save.TextValue(key: string, scope: any?): string?
    local value = scalarOf(scope, "Texts", key)
    if typeof(value) ~= "string" then
        return nil
    end
    return value :: string
end

function Save.SetHackBind(key: string, bind: any?, scope: any?)
    if typeof(key) ~= "string" or key == "" then
        return
    end
    bindsOf(scope).Hacks[key] = normalizeBind(bind)
    scheduleCommit()
end

function Save.HackBind(key: string, scope: any?): any?
    if typeof(key) ~= "string" then
        return nil
    end
    return normalizeBind(bindsOf(scope).Hacks[key])
end

function Save.AllHackBinds(): { [string]: any }
    local out: { [string]: any } = {}
    for _, store in stores do
        local perScope: { [string]: any } = {}
        for key, bind in storeData[store.Scope].Keybinds.Hacks :: { any } do
            if typeof(key) == "string" then
                local clean = normalizeBind(bind)
                if clean ~= nil then
                    perScope[key] = clean
                end
            end
        end
        out[store.Scope] = perScope
    end
    return out
end

function Save.SetActionBind(key: string, bind: any?, scope: any?)
    if typeof(key) ~= "string" or key == "" then
        return
    end
    bindsOf(scope).Actions[key] = normalizeBind(bind)
    scheduleCommit()
end

function Save.ActionBind(key: string, scope: any?): any?
    if typeof(key) ~= "string" then
        return nil
    end
    return normalizeBind(bindsOf(scope).Actions[key])
end

function Save.AllActionBinds(scope: any?): { [string]: any }
    local out: { [string]: any } = {}
    for key, bind in bindsOf(scope).Actions :: { any } do
        if typeof(key) == "string" then
            local clean = normalizeBind(bind)
            if clean ~= nil then
                out[key] = clean
            end
        end
    end
    return out
end

function Save.SetToggleUIBind(bind: any?, scope: any?)
    bindsOf(scope).ToggleUI = normalizeBind(bind)
    scheduleCommit()
end

function Save.ToggleUIBind(scope: any?): any?
    return normalizeBind(bindsOf(scope).ToggleUI)
end

function Save.SetCustomBind(key: string, bind: any?, scope: any?)
    if typeof(key) ~= "string" or key == "" then
        return
    end
    bindsOf(scope).Custom[key] = normalizeBind(bind)
    scheduleCommit()
end

function Save.CustomBind(key: string, scope: any?): any?
    if typeof(key) ~= "string" then
        return nil
    end
    return normalizeBind(bindsOf(scope).Custom[key])
end

genv.GDH_Save = Save

return Save

end
MODULES["src/Function/Storage.luau"] = function()
local WorkspaceService = workspace

local Storage: any = {}

local GDH_ROOT_NAME = "GDH"
local MACROS_SUBPATH = "Macros"
local MACRO_EXTENSION = ".re4"
local MACRO_FS_DIR = "GDH/Macros"

local function normalizePath(path: string?): string
    local value = if path ~= nil then tostring(path) else ""
    value = value:gsub("\\+", "/")
    value = value:gsub("^/+", "")
    value = value:gsub("/+$", "")
    while value:find("//", 1, true) ~= nil do
        value = value:gsub("//", "/")
    end
    return value
end

local function splitPath(path: string): { string }
    local parts: { string } = {}
    for _, part in string.split(path, "/") do
        if part ~= "" then
            table.insert(parts, part)
        end
    end
    return parts
end

local function isControlFree(part: string): boolean
    for i = 1, #part do
        local byte = string.byte(part, i)
        if byte < 32 or byte == 127 then
            return false
        end
    end
    return true
end

local function validLeafName(name: string): boolean
    if name == "" or name == "." or name == ".." then
        return false
    end
    if name:find("[/]", 1, false) ~= nil then
        return false
    end
    return isControlFree(name)
end

local function validSegment(part: string): boolean
    if not validLeafName(part) then
        return false
    end
    if part:find("[\\:%*%?\"<>|]", 1, false) ~= nil then
        return false
    end
    return true
end

local function ensureRoot(): Folder?
    local ok, result = pcall(function(): Folder
        local existing = WorkspaceService:FindFirstChild(GDH_ROOT_NAME)
        if existing ~= nil and existing:IsA("Folder") then
            return existing
        end
        if existing ~= nil then
            existing:Destroy()
        end
        local folder = Instance.new("Folder")
        folder.Name = GDH_ROOT_NAME
        folder.Parent = WorkspaceService
        return folder
    end)
    if ok and typeof(result) == "Instance" then
        return result
    end
    return nil
end

function Storage.Root(): Instance?
    return ensureRoot()
end

function Storage:Folder(path: string?): Instance?
    local current = ensureRoot()
    if current == nil then
        return nil
    end
    local parts = splitPath(normalizePath(path))
    for _, part in parts do
        if not validSegment(part) then
            return nil
        end
        local child = current:FindFirstChild(part)
        if child ~= nil and child:IsA("Folder") then
            current = child
        else
            if child ~= nil then
                child:Destroy()
            end
            local folder = Instance.new("Folder")
            folder.Name = part
            folder.Parent = current
            current = folder
        end
    end
    if #parts == 0 then
        return current
    end
    return current
end

function Storage:Has(path: string?): boolean
    local parts = splitPath(normalizePath(path))
    if #parts == 0 then
        local root = WorkspaceService:FindFirstChild(GDH_ROOT_NAME)
        return root ~= nil and root:IsA("Folder")
    end
    local current = ensureRoot()
    if current == nil then
        return false
    end
    for _, part in parts do
        local nextNode = current:FindFirstChild(part)
        if nextNode == nil then
            return false
        end
        current = nextNode
    end
    return true
end

function Storage:Children(path: string?): { Instance }
    local node = Storage:Folder(path)
    if node == nil then
        return {}
    end
    return node:GetChildren()
end

function Storage:Names(path: string?): { string }
    local names: { string } = {}
    for _, child in Storage:Children(path) do
        table.insert(names, child.Name)
    end
    return names
end

function Storage:Clear(path: string?): number
    local node = Storage:Folder(path)
    if node == nil then
        return 0
    end
    local count = 0
    for _, child in node:GetChildren() do
        child:Destroy()
        count += 1
    end
    return count
end

function Storage:Write(path: string?, name: string, data: string): Instance?
    local parent = Storage:Folder(path)
    if parent == nil or not validLeafName(tostring(name)) then
        return nil
    end
    local leafName = tostring(name)
    local existing = parent:FindFirstChild(leafName)
    if existing ~= nil and existing:IsA("StringValue") then
        existing.Value = data
        return existing
    end
    if existing ~= nil then
        existing:Destroy()
    end
    local value = Instance.new("StringValue")
    value.Name = leafName
    value.Value = data
    value.Parent = parent
    return value
end

function Storage:Read(path: string?, name: string): string?
    local parent = Storage:Folder(path)
    if parent == nil then
        return nil
    end
    local existing = parent:FindFirstChild(tostring(name))
    if existing ~= nil and existing:IsA("StringValue") then
        return existing.Value
    end
    return nil
end

function Storage:Delete(path: string?, name: string): boolean
    local parent = Storage:Folder(path)
    if parent == nil then
        return false
    end
    local existing = parent:FindFirstChild(tostring(name))
    if existing == nil then
        return false
    end
    existing:Destroy()
    return true
end

function Storage:Rename(path: string?, oldName: string, newName: string): Instance?
    local parent = Storage:Folder(path)
    if parent == nil then
        return nil
    end
    if not validLeafName(tostring(newName)) then
        return nil
    end
    local existing = parent:FindFirstChild(tostring(oldName))
    if existing == nil then
        return nil
    end
    local collision = parent:FindFirstChild(tostring(newName))
    if collision ~= nil then
        collision:Destroy()
    end
    existing.Name = tostring(newName)
    return existing
end

local function fsAvailable(): boolean
    return typeof(writefile) == "function"
        and typeof(readfile) == "function"
        and typeof(isfolder) == "function"
        and typeof(makefolder) == "function"
        and typeof(isfile) == "function"
end

local function ensureFsDirectory(folderPath: string)
    if typeof(makefolder) ~= "function" or typeof(isfolder) ~= "function" then
        return
    end
    local parts = splitPath(normalizePath(folderPath))
    local current = ""
    for _, part in parts do
        current = if current == "" then part else current .. "/" .. part
        if not isfolder(current) then
            pcall(makefolder, current)
        end
    end
end

local function normalizeMacroName(name: string): string
    local macroName = tostring(name)
    if macroName:sub(-#MACRO_EXTENSION) ~= MACRO_EXTENSION then
        macroName = macroName .. MACRO_EXTENSION
    end
    return macroName
end

local function macroIdFromFileName(fileName: string): string
    if fileName:sub(-#MACRO_EXTENSION) == MACRO_EXTENSION then
        return fileName:sub(1, #fileName - #MACRO_EXTENSION)
    end
    return fileName
end

function Storage:MacrosFolder(): Instance?
    return Storage:Folder(MACROS_SUBPATH)
end

function Storage:SaveMacro(name: string, data: string): boolean
    local macroId = tostring(name)
    if macroId == "" or not validSegment(macroId) then
        return false
    end
    local macroName = normalizeMacroName(macroId)
    local savedInstance = false
    local instanceError: string? = nil
    local okInstance, instanceResult = pcall(function(): Instance?
        return Storage:Write(MACROS_SUBPATH, macroName, data)
    end)
    if okInstance then
        savedInstance = instanceResult ~= nil
    else
        instanceError = tostring(instanceResult)
    end
    local savedFile = false
    if fsAvailable() then
        ensureFsDirectory(MACRO_FS_DIR)
        local okFile = pcall(function()
            writefile(MACRO_FS_DIR .. "/" .. macroName, data)
        end)
        savedFile = okFile
    end
    if not savedInstance and not savedFile then
        if instanceError ~= nil then
            pcall(warn, "[GDH Storage] macro write failed: " .. instanceError)
        end
        return false
    end
    return true
end

function Storage:LoadMacro(name: string): string?
    local macroId = tostring(name)
    if macroId == "" or not validSegment(macroId) then
        return nil
    end
    local macroName = normalizeMacroName(macroId)
    local data = Storage:Read(MACROS_SUBPATH, macroName)
    if data ~= nil then
        return data
    end
    if typeof(readfile) == "function" and typeof(isfile) == "function" then
        local filePath = MACRO_FS_DIR .. "/" .. macroName
        if isfile(filePath) then
            local ok, content = pcall(readfile, filePath)
            if ok and typeof(content) == "string" then
                return content
            end
        end
    end
    return nil
end

function Storage:HasMacro(name: string): boolean
    local macroId = tostring(name)
    if macroId == "" or not validSegment(macroId) then
        return false
    end
    local macroName = normalizeMacroName(macroId)
    local parent = Storage:Folder(MACROS_SUBPATH)
    if parent ~= nil and parent:FindFirstChild(macroName) ~= nil then
        return true
    end
    if typeof(isfile) == "function" then
        local ok, found = pcall(function()
            return isfile(MACRO_FS_DIR .. "/" .. macroName)
        end)
        if ok and found then
            return true
        end
    end
    return false
end

function Storage:ListMacros(): { string }
    local ids: { string } = {}
    local seen: { [string]: boolean } = {}
    local parent = Storage:Folder(MACROS_SUBPATH)
    if parent ~= nil then
        for _, child in parent:GetChildren() do
            if child:IsA("StringValue") then
                local id = macroIdFromFileName(child.Name)
                if id ~= "" and seen[id] ~= true then
                    seen[id] = true
                    table.insert(ids, id)
                end
            end
        end
    end
    local listFn = nil
    if typeof(listfolder) == "function" then
        listFn = listfolder
    elseif typeof(listfiles) == "function" then
        listFn = listfiles
    end
    if typeof(listFn) == "function" and typeof(isfolder) == "function" and typeof(isfile) == "function" then
        pcall(function()
            if (isfolder :: any)(MACRO_FS_DIR) then
                for _, entry in (listFn :: any)(MACRO_FS_DIR) do
                    if typeof(entry) == "string" then
                        local normalized = string.gsub(entry, "\\", "/")
                        local slashAt = string.find(normalized, "/[^/]*$")
                        local baseName = normalized
                        if slashAt ~= nil then
                            baseName = string.sub(normalized, slashAt + 1)
                        end
                        local fullPath = if string.find(normalized, "/", 1, true) ~= nil
                            then normalized
                            else MACRO_FS_DIR .. "/" .. baseName
                        local isFileOk = pcall(function()
                            return (isfile :: any)(fullPath)
                        end)
                        if isFileOk and baseName ~= "" then
                            local id = macroIdFromFileName(baseName)
                            if id ~= "" and seen[id] ~= true then
                                seen[id] = true
                                table.insert(ids, id)
                            end
                        end
                    end
                end
            end
        end)
    end
    table.sort(ids)
    return ids
end

function Storage:DeleteMacro(name: string): boolean
    local macroId = tostring(name)
    if macroId == "" or not validSegment(macroId) then
        return false
    end
    local macroName = normalizeMacroName(macroId)
    local removed = Storage:Delete(MACROS_SUBPATH, macroName)
    if typeof(delfile) == "function" and typeof(isfile) == "function" then
        local filePath = MACRO_FS_DIR .. "/" .. macroName
        pcall(function()
            if isfile(filePath) then
                (delfile :: any)(filePath)
            end
        end)
    end
    return removed
end

return Storage

end
