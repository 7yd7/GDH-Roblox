    Callback = rejoin,
})

shortcutsWindow:AddButton({
    Text = "Server Hop",
    Description = "Join a different public server",
    Callback = serverHop,
})

shortcutsWindow:AddButton({
    Text = "Reset Character",
    Description = "Reset your character",
    Callback = resetCharacter,
})

shortcutsWindow:AddButton({
    Text = "Open Mobile UI",
    Description = "Toggle the mobile interface",
    Callback = openMobileUI,
})

shortcutsWindow:AddButton({
    Text = "Restart Script",
    Description = "Restart the GDH UI and scripts",
    Callback = restartScript,
})

do
    local actions = genv.GDH_KeybindActions
    if typeof(actions) ~= "table" then
        actions = {}
        genv.GDH_KeybindActions = actions
    end

    local known: { [string]: boolean } = {}
    for _, action in actions do
        if typeof(action) == "table" and typeof(action.Id) == "string" then
            known[action.Id] = true
        end
    end

    local entries = {
        { Id = "Shortcuts::Rejoin", Name = "Rejoin", Callback = rejoin },
        { Id = "Shortcuts::ServerHop", Name = "Server Hop", Callback = serverHop },
        { Id = "Shortcuts::ResetCharacter", Name = "Reset Character", Callback = resetCharacter },
        { Id = "Shortcuts::MobileUI", Name = "Open Mobile UI", Callback = openMobileUI },
        { Id = "Shortcuts::Restart", Name = "Restart Script", Callback = restartScript },
    }
    for _, entry in entries do
        if known[entry.Id] ~= true then
            known[entry.Id] = true
            table.insert(actions, {
                Id = entry.Id,
                Module = "Shortcuts",
                Name = entry.Name,
                Default = nil,
                Callback = entry.Callback,
            })
        end
    end

    local sync = genv.GDH_KeybindActionsSync
    if typeof(sync) == "function" then
        sync()
    else
        task.defer(function()
            local deferredSync = genv.GDH_KeybindActionsSync
            if typeof(deferredSync) == "function" then
                deferredSync()
            end
        end)
    end
end

end
MODULES["Script/Geometry Dash 2.2/Features/Bypass/Bypass.luau"] = function()
local enabled = false
local rules = nil
local originalAccess = nil
local originalPolicy = nil
local originalCanStart = nil

local function getRules()
    if rules then
        return rules
    end
    local ok, mod = pcall(function()
        local port = game:GetService("ReplicatedStorage"):FindFirstChild("GDPort")
        local pr = port and port:FindFirstChild("ProgressionRules")
        return pr and require(pr) or nil
    end)
    if ok and type(mod) == "table" and type(mod.access) == "function"
        and type(mod.policy) == "function" and type(mod.canStart) == "function"
    then
        rules = mod
    end
    return rules
end

local function apply()
    local mod = getRules()
    if not mod then
        return
    end
    if enabled then
        if originalAccess == nil then
            originalAccess = mod.access
            originalPolicy = mod.policy
            originalCanStart = mod.canStart
        end
        mod.access = function(self, ...)
            local ok, result = pcall(originalAccess, self, ...)
            if ok and type(result) == "table" then
                result.allowed = true
                result.reason = nil
                result.enforced = false
                return result
            end
            return { allowed = true, enforced = false }
        end
        mod.policy = function(self, ...)
            local ok, result = pcall(originalPolicy, self, ...)
            if ok and type(result) == "table" then
                result.enforced = {
                    officialCoinGates = false,
                    towerFloorOrder = false,
                    challengeVault = false,
                }
                return result
            end
            return {
                enforced = {
                    officialCoinGates = false,
                    towerFloorOrder = false,
                    challengeVault = false,
                },
            }
        end
        mod.canStart = function(self, ...)
            local ok, allowed, reason, info = pcall(originalCanStart, self, ...)
            if not ok then
                return true, nil, { allowed = true }
            end
            if type(info) ~= "table" then
                info = {}
            end
            info.allowed = true
            info.reason = nil
            return true, nil, info
        end
    elseif originalAccess ~= nil then
        mod.access = originalAccess
        mod.policy = originalPolicy
        mod.canStart = originalCanStart
        originalAccess, originalPolicy, originalCanStart = nil, nil, nil
    end
end

local MainLevels = {}

function MainLevels.Set(state)
    enabled = state == true
    apply()
end

function MainLevels.IsEnabled()
    return enabled
end

function MainLevels.Setup(window)
    window:AddToggle({
        Name = "Main Levels",
        Default = false,
        Description = "Make every main level playable",
        Callback = function(state)
            MainLevels.Set(state)
        end,
    })
end

return MainLevels

end
