                :Lerp(Theme.Colors.ButtonTextHover, th)
                :Lerp(Theme.Colors.ButtonTextActive, eased)

            if conn ~= nil and settled and tHeld == targetHeld then
                loopConn = nil
                conn:Disconnect()
