MODULES["Script/Geometry Dash 2.2/Features/Level/StraightFlyBot.luau"] = function()
local RunService = game:GetService("RunService")

local genv = (typeof(getgenv) == "function" and getgenv())
    or (typeof(_G) == "table" and _G)
    or {}

local StraightFlyBot = {}
local enabled = false
local conn = nil
local states = setmetatable({}, { __mode = "k" })

local function getRuntime()
    local ok, mod = pcall(function()
        local port = game:GetService("ReplicatedStorage"):FindFirstChild("GDPort")
        local rt = port and port:FindFirstChild("ClientRuntime")
        return rt and require(rt) or nil
    end)
    if ok and type(mod) == "table" then
        return mod
    end
    return nil
end

local function numberSetting(key, default)
    local store = genv.GDH_HACK_SETTINGS_STATE
    local state = type(store) == "table" and store["straight fly bot"] or nil
    local value = type(state) == "table" and state[key] or nil
    if type(value) == "number" then
        return value
    end
    return default
end

local function flagSetting(key, default)
    local store = genv.GDH_HACK_SETTINGS_STATE
    local state = type(store) == "table" and store["straight fly bot"] or nil
    local value = type(state) == "table" and state[key] or nil
    if type(value) == "boolean" then
        return value
    end
    return default
end

local function release(player)
    local entry = states[player]
    if type(entry) ~= "table" or not entry.holding then
        return
    end
    pcall(function()
        player:releaseButton(1)
    end)
    entry.holding = false
end

local function releaseAll()
    for player, entry in pairs(states) do
        if type(entry) == "table" and entry.holding then
            pcall(function()
                player:releaseButton(1)
            end)
            entry.holding = false
        end
    end
end

local function push(player)
    local entry = states[player]
    if type(entry) ~= "table" or entry.holding then
        return
    end
    pcall(function()
        player:pushButton(1)
    end)
    entry.holding = true
end

local function start()
    if conn then
        return
    end
    conn = RunService.Heartbeat:Connect(function()
        if not enabled then
            releaseAll()
            return
        end
        local runtime = getRuntime()
        local pass = runtime and runtime.layer and runtime.layer.pass
        local okScreen, screen = pcall(function()
            return runtime.snapshot and runtime.snapshot().screen
        end)
        if type(pass) ~= "table" or not okScreen or screen ~= "playing" then
            releaseAll()
            return
        end

        local accuracy = math.max(0, numberSetting("y_accuracy", 40))
        for index = 1, 2 do
            local player = index == 1 and pass.p1 or pass.p2
            local selected = index == 1
                and flagSetting("first_player", true)
                or flagSetting("second_player", false)
            if type(player) ~= "table" or not selected
                or player.isDead == true or player.isShip ~= true
            then
                if type(player) == "table" then
                    release(player)
                    local old = states[player]
                    if type(old) == "table" then
                        old.target = nil
                    end
                end
                continue
            end

            local entry = states[player]
            if type(entry) ~= "table" then
                entry = {}
                states[player] = entry
            end
            local y = tonumber(player.y)
            if y == nil then
                release(player)
                continue
            end
            if entry.target == nil then
                entry.target = y
            end
            local delta = entry.target - y
            if delta > accuracy then
                push(player)
            elseif delta < -accuracy then
                release(player)
            end
        end
    end)
end

function StraightFlyBot.Set(state)
    enabled = state == true
    if enabled then
        start()
    else
        releaseAll()
        if conn then
            conn:Disconnect()
            conn = nil
        end
    end
end

function StraightFlyBot.IsEnabled()
    return enabled
end

function StraightFlyBot.Setup(window)
    window:AddToggle({
        Name = "Straight Fly Bot",
        Default = false,
        Description = "Keeps the ship flying level by holding and releasing jump",
        Cheating = true,
        Settings = {
            { Kind = "Float", Text = "Y Accuracy", Key = "y_accuracy", Min = 0, Max = 1000, Default = 40, Increment = 0.5, Precision = 1 },
            { Kind = "Toggle", Text = "First Player", Key = "first_player", Default = true },
            { Kind = "Toggle", Text = "Second Player", Key = "second_player", Default = false },
        },
        Callback = function(state)
            StraightFlyBot.Set(state)
        end,
    })
end

return StraightFlyBot

end
MODULES["Script/Geometry Dash 2.2/Features/Level/Util.luau"] = function()
local RunService = game:GetService("RunService")

local Util = {}
local callbacks = {}
local simulation = nil
local originalNew = nil
local hooked = false
local watchConn = nil
local moduleCache = {}

function Util.Get(path)
    if moduleCache[path] ~= nil then
        return moduleCache[path]
    end
    local ok, mod = pcall(function()
        local node = game:GetService("ReplicatedStorage"):FindFirstChild("GDPort")
        for part in path:gmatch("[^/]+") do
            node = node and node:FindFirstChild(part)
            if not node then
                return nil
            end
        end
        return node and require(node) or nil
    end)
    if ok and type(mod) == "table" then
        moduleCache[path] = mod
        return mod
    end
    return nil
end

function Util.NewHook()
    local hook = { entries = {} }

    function hook:Set(path, name, replacement)
        local mod = Util.Get(path)
        if type(mod) ~= "table" or type(mod[name]) ~= "function" then
            return false
        end
        local byName = self.entries[mod]
        if not byName then
            byName = {}
            self.entries[mod] = byName
        end
        if byName[name] == nil then
            byName[name] = mod[name]
        end
        mod[name] = replacement
        return true
    end

    function hook:Wrap(path, name, wrapper)
        local mod = Util.Get(path)
        if type(mod) ~= "table" or type(mod[name]) ~= "function" then
            return false
        end
        local byName = self.entries[mod]
        local original = byName and byName[name] or mod[name]
        return self:Set(path, name, function(...)
            return wrapper(original, ...)
        end)
    end

    function hook:Restore()
        for mod, byName in pairs(self.entries) do
            for name, original in pairs(byName) do
                mod[name] = original
            end
        end
        table.clear(self.entries)
    end

    return hook
end

function Util.Noop()
end

local function getSimulationModule()
    local ok, mod = pcall(function()
        local port = game:GetService("ReplicatedStorage"):FindFirstChild("GDPort")
        local sim = port and port:FindFirstChild("Simulation")
        return sim and require(sim) or nil
    end)
    if ok and type(mod) == "table" and type(mod.new) == "function" then
        return mod
    end
    return nil
end

local function tryHook()
    if hooked then
        return true
    end
    local mod = getSimulationModule()
    if not mod then
        return false
    end
    originalNew = mod.new
    mod.new = function(...)
        local instance = originalNew(...)
        simulation = instance
        for _, callback in ipairs(callbacks) do
            pcall(callback, instance)
        end
        return instance
    end
    hooked = true
    if watchConn then
        watchConn:Disconnect()
        watchConn = nil
    end
    return true
end

function Util.OnLevelStart(callback)
    if type(callback) ~= "function" then
        return
    end
    callbacks[#callbacks + 1] = callback
    if not tryHook() and not watchConn then
        watchConn = RunService.RenderStepped:Connect(function()
            tryHook()
        end)
    end
end

function Util.GetSimulation()
    return simulation
end

return Util

end
MODULES["Script/Geometry Dash 2.2/loader.luau"] = function()
local genv = (typeof(getgenv) == "function" and getgenv())
    or (typeof(_G) == "table" and _G)
    or {}

local UI = genv.GDH_UI
if typeof(UI) ~= "table" then
    return
end

local modules = genv.GDH_MODULES
if typeof(modules) ~= "table" then
    return
end

local FEATURES = "Script/Geometry Dash 2.2/Features/"

local WINDOW_ORDER = {
    Core = 1,
    Bypass = "1-1",
    Cosmetic = 2,
    Level = 3
}

local folders = {}
for key in pairs(modules) do
    if key:sub(1, #FEATURES) == FEATURES then
        local name = key:sub(#FEATURES + 1):match("^([^/]+)/")
        if name and name ~= "" then
            folders[name] = true
        end
    end
end

local names = {}
for name in pairs(folders) do
    names[#names + 1] = name
end
table.sort(names)

local scale = UI.Theme and UI.Theme.ScreenScale or 1
local function px(n: number): number
    return math.floor(n * scale + 0.5)
end

for index, name in ipairs(names) do
    local prefix = FEATURES .. name .. "/"
    local order = WINDOW_ORDER[name] or (10 + index)
    local window = UI:CreateWindow({
        Title = name,
        Order = order,
        Size = UDim2.fromOffset(px(210), px(120)),
        AutoHeight = true,
    })

    local files = {}
    for key in pairs(modules) do
        if key:sub(1, #prefix) == prefix and key:sub(-5) == ".luau" then
            local relative = key:sub(#prefix + 1)
            if not relative:find("/") then
                files[#files + 1] = key
            end
        end
    end
    table.sort(files)

    for _, key in ipairs(files) do
        local ok, feature = pcall(modules[key])
        if ok then
            if typeof(feature) == "table" and typeof(feature.Setup) == "function" then
                pcall(feature.Setup, window)
            end
        else
            warn("[GDH] " .. key .. ": " .. tostring(feature))
        end
    end
end

local MAP_PREFIX = "Script/Geometry Dash 2.2/"
local LOADER_KEY = MAP_PREFIX .. "loader.luau"

for key in pairs(modules) do
    local isMapScript = key:sub(1, #MAP_PREFIX) == MAP_PREFIX
        and key:sub(-5) == ".luau"
        and key:sub(1, #FEATURES) ~= FEATURES
        and key ~= LOADER_KEY
    if isMapScript then
        task.spawn(function()
            local ok, err = pcall(modules[key])
            if not ok then
                warn("[GDH] " .. key .. ": " .. tostring(err))
            end
        end)
    end
end

end
