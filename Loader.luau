            corner.CornerRadius = UDim.new(
                0, math.floor(baseRadius * (1 - eased * 0.8) + 0.5))
            bg.BackgroundColor3 = Theme.Colors.ButtonBG
                :Lerp(Theme.Colors.ButtonBGHover, th)
