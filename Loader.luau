    local function popupItems(): { string }
        local items: { string } = {}
        local macros = listMacros()
        if #macros > 0 then
            for _, macroId in macros do
                table.insert(items, tostring(macroId))
            end
            return items
        end
        for _, name in state.Saved :: { any } do
            table.insert(items, tostring(name))
        end
        return items
    end

