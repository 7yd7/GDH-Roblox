		popup = nil
		if current ~= nil then
			pcall(function()
				current:Destroy()
			end)
		end
	end

	local container = Instance.new("Frame")
	container.Name = "HackSettingsPopup"
	container.Active = true
	container.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	container.BackgroundTransparency = 0.45
	container.BorderSizePixel = 0
	container.Position = UDim2.fromScale(0, 0)
	container.Size = UDim2.fromScale(1, 1)
	container.ZIndex = 60
	container.Parent = popHost

	PressFlow.Register({
		Node = container,
	})

	local panel = Instance.new("Frame")
	panel.Name = "Panel"
	panel.Active = true
	panel.BackgroundColor3 = colors.MenuBG
	panel.BorderSizePixel = 0
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.new(0.5, 0, 0.5, 0)
	panel.Size = UDim2.fromOffset(popW, popH)
	panel.ZIndex = 61
	panel.Parent = container

	local panelCorner = Instance.new("UICorner")
	panelCorner.CornerRadius = UDim.new(0, math.floor(layout.BgCorner * (popW / layout.BgW) + 0.5))
	panelCorner.Parent = panel

	local panelStroke = Instance.new("UIStroke")
	panelStroke.Color = colors.MenuStroke
	panelStroke.Thickness = layout.BgStroke
	panelStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	panelStroke.Parent = panel

	local fitNode = config.Fit
	local fitValue = 1
	if typeof(fitNode) == "Instance" and (fitNode :: Instance):IsA("UIScale") then
		fitValue = (fitNode :: UIScale).Scale
	end

	local popScale = Instance.new("UIScale")
	popScale.Scale = fitValue * 0.55
	popScale.Parent = panel
	Animate.Tween(popScale, 0.8, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out, {
		Scale = fitValue,
	})

	local assets = Theme.GetAssets()

	local closeBtn: GuiObject
	if typeof(assets.Close) == "string" and (assets.Close :: string) ~= "" then
		local closeImage = Instance.new("ImageButton")
		closeImage.Name = "Close"
		closeImage.AutoButtonColor = false
		closeImage.BackgroundTransparency = 1
		closeImage.BorderSizePixel = 0
		closeImage.Position = UDim2.fromOffset(closeX, closeY)
		closeImage.Size = UDim2.fromOffset(closeW, closeH)
		closeImage.Image = assets.Close :: string
		closeImage.ScaleType = Enum.ScaleType.Fit
		closeImage.ZIndex = 64
		closeImage.Parent = panel
		closeBtn = closeImage
	else
		local closeText = Instance.new("TextButton")
		closeText.Name = "Close"
		closeText.AutoButtonColor = false
		closeText.BackgroundColor3 = colors.SwitchTrackOff
		closeText.BorderSizePixel = 0
		closeText.Position = UDim2.fromOffset(closeX, closeY)
		closeText.Size = UDim2.fromOffset(closeW, closeH)
		closeText.FontFace = Theme.GetFace()
		closeText.Text = "✕"
		closeText.TextColor3 = colors.TextPrimary
		closeText.TextSize = layout.LabelSize
		closeText.ZIndex = 64
		closeText.Parent = panel
		local closeCorner = Instance.new("UICorner")
		closeCorner.CornerRadius = UDim.new(1, 0)
		closeCorner.Parent = closeText
		closeBtn = closeText
	end

	local closeFeedback = Animate.HoldFeedback(closeBtn, closeBtn, {
		Grow = 1.18,
		GrowTime = 0.15,
		ReleaseTime = 0.6,
		ReleaseStyle = Enum.EasingStyle.Elastic,
	})
	local closeTarget = {
		Node = closeBtn,
		PressIn = closeFeedback.Press,
		PressOut = closeFeedback.Reverse,
		Release = closeFeedback.Release,
	}
	PressFlow.Register(closeTarget)

	closeBtn.InputBegan:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			PressFlow.Begin(closeTarget, input)
		end
	end)

	closeBtn.Activated:Connect(function()
		closePopup()
	end)

	local contentTop = 60
	local itemTextSize = layout.LabelSize

	local titleText = tostring(config.Title or "Settings")
	if string.sub(string.lower(titleText), -8) ~= "settings" then
		titleText = titleText .. " Settings"
	end

	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.BackgroundTransparency = 1
	title.BorderSizePixel = 0
	title.Position = UDim2.fromOffset(0, 0)
	title.Size = UDim2.new(1, 0, 0, 44)
	title.AutomaticSize = Enum.AutomaticSize.None
	title.FontFace = Theme.GetFace()
	title.Text = titleText
	title.TextColor3 = colors.TextPrimary
	title.TextSize = 36
	title.TextTruncate = Enum.TextTruncate.None
	title.TextWrapped = false
	title.TextXAlignment = Enum.TextXAlignment.Center
	title.ZIndex = 62
	title.Parent = panel
	FitText.fit(title, {
		Base = 36,
		Min = 16,
	})

	if #items == 0 then
		local empty = Instance.new("TextLabel")
		empty.Name = "Empty"
		empty.BackgroundTransparency = 1
		empty.BorderSizePixel = 0
		empty.Position = UDim2.fromOffset(30, contentTop)
		empty.Size = UDim2.new(1, -60, 1, -(contentTop + 24))
		empty.FontFace = Theme.GetFace()
		empty.Text = "No settings available"
		empty.TextColor3 = colors.RadioRingOff
		empty.TextSize = itemTextSize
		empty.TextXAlignment = Enum.TextXAlignment.Center
		empty.TextYAlignment = Enum.TextYAlignment.Center
		empty.ZIndex = 62
		empty.Parent = panel
	else
		local scroll = Instance.new("ScrollingFrame")
		scroll.Name = "Items"
		scroll.BackgroundTransparency = 1
		scroll.BorderSizePixel = 0
		scroll.Position = UDim2.fromOffset(30, contentTop)
		scroll.Size = UDim2.new(1, -60, 1, -contentTop)
		scroll.ScrollBarThickness = 0
		scroll.ScrollBarImageTransparency = 1
		scroll.ScrollingDirection = Enum.ScrollingDirection.Y
		scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
		scroll.CanvasSize = UDim2.fromScale(0, 0)
		scroll.ElasticBehavior = Enum.ElasticBehavior.Always
		scroll.Selectable = false
		scroll.ZIndex = 62
		scroll.Parent = panel

		local scrollLayout = Instance.new("UIListLayout")
		scrollLayout.SortOrder = Enum.SortOrder.LayoutOrder
		scrollLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
		scrollLayout.Padding = UDim.new(0, 20)
		scrollLayout.Parent = scroll

		local index = 0
		for _, item in items :: { any } do
			if typeof(item) ~= "table" then
				continue
			end
			index += 1
			local kind = tostring(item.Kind or "Button")

			local wrapper = Instance.new("Frame")
			wrapper.Name = "Item" .. index
			wrapper.BackgroundTransparency = 1
			wrapper.BorderSizePixel = 0
			wrapper.Size = UDim2.new(1, 0, 0, layout.RowH)
			wrapper.LayoutOrder = index
			wrapper.ZIndex = 62
			wrapper.Parent = scroll

			if kind == "Toggle" then
				ToggleCell({
					Row = item.Row,
					Name = item.Text,
					Parent = wrapper,
					Notify = notifyFn,
					Center = true,
				})
			elseif kind == "Slider" then
				local sliderFrame = SliderCell({
					Parent = wrapper,
					Row = item.Row,
					Name = item.Name,
					Suffix = item.Suffix,
					Min = item.Min,
					Max = item.Max,
					Increment = item.Increment,
					Precision = item.Precision,
					HasToggle = item.HasToggle,
					Center = true,
				})
				local valueBox = sliderFrame:FindFirstChild("Value", true)
				local mirrorRow = item.Row
				if typeof(mirrorRow) == "Instance" and typeof(valueBox) == "TextBox" then
					local precision = 2
					if typeof(item.Precision) == "number" then
						precision = math.clamp(item.Precision :: number, 0, 6)
					end
					table.insert(itemSyncConns, (mirrorRow :: Instance):GetAttributeChangedSignal("GDHSettingValue"):Connect(function()
						local value = (mirrorRow :: Instance):GetAttribute("GDHSettingValue")
						if typeof(value) ~= "number" then
							return
						end
						(valueBox :: TextBox).Text = string.format("%." .. precision .. "f", value)
					end))
				end
			elseif kind == "Color" then
				local getter = item.Get
				local setter = item.Set

				local function colorIndexOf(color: any): number
					for i = 1, #titleColors do
						if titleColors[i] == color then
							return i
						end
					end
					return 0
				end

				local function currentColor(): any
					if typeof(getter) == "function" then
						local ok, value = pcall(getter :: any)
						if ok then
							return value
						end
					end
					return nil
				end

				local function rowText(): string
					local colorIndex = colorIndexOf(currentColor())
					local colorName = "Default"
					if colorIndex > 0 then
						colorName = titleColorNames[colorIndex]
					end
					return tostring(item.Text or "Title Color") .. ": " .. colorName
				end

				local function cycle()
					local nextIndex = colorIndexOf(currentColor()) + 1
					if nextIndex == 1 or nextIndex > #titleColors then
						nextIndex = 2
					end
					if typeof(setter) == "function" then
						pcall(setter :: any, titleColors[nextIndex])
					end
				end

				local buttonFrame = ButtonRow({
					Parent = wrapper,
					Buttons = { { Text = rowText(), Fire = cycle } },
				})

				local function refreshText()
					local slot = buttonFrame:FindFirstChild("Slot1")
					if typeof(slot) ~= "Instance" then
						return
					end
					local node = (slot :: Instance):FindFirstChild("Button1")
					if typeof(node) == "TextButton" then
						(node :: TextButton).Text = rowText()
					end
				end

				local mirrorRow = item.Row
				if typeof(mirrorRow) == "Instance" then
					table.insert(itemSyncConns, (mirrorRow :: Instance):GetAttributeChangedSignal("GDHSettingValue"):Connect(function()
						refreshText()
					end))
				end
			elseif kind == "Int" or kind == "Float" then
				local isFloat = kind == "Float"
				local inputCell = NumberInput({
					Parent = wrapper,
					IsFloat = isFloat,
					Name = tostring(item.Text or ""),
					Min = item.Min,
					Max = item.Max,
					Default = item.Default,
					Get = item.Get,
					Set = item.Set,
					Center = true,
				})

				local mirrorRow = item.Row
				if typeof(mirrorRow) == "Instance" then
					table.insert(itemSyncConns, (mirrorRow :: Instance):GetAttributeChangedSignal("GDHSettingValue"):Connect(function()
						local value = (mirrorRow :: Instance):GetAttribute("GDHSettingValue")
						if typeof(value) ~= "number" then
							return
						end
						local box = inputCell:FindFirstChild("Input", true)
						if typeof(box) == "TextBox" then
							(box :: TextBox).Text = if isFloat
								then string.format("%.2f", value)
								else tostring(math.floor(value + 0.5))
						end
					end))
				end
			elseif kind == "Separator" then
				local height = 18
				local source = item.Row
				if typeof(source) == "Instance" then
					local pcHeight = (source :: Instance).Size.Y.Offset
					if pcHeight > 0 then
						height = math.clamp(pcHeight, 14, 48)
					end
				end
				wrapper.Size = UDim2.new(1, 0, 0, height)
				local line = Instance.new("Frame")
				line.Name = "Line"
				line.BackgroundColor3 = colors.Separator
				line.BackgroundTransparency = 0.55
				line.BorderSizePixel = 0
				line.AnchorPoint = Vector2.new(0, 0.5)
				line.Position = UDim2.new(0, 0, 0.5, 0)
				line.Size = UDim2.new(1, 0, 0, 2)
				line.ZIndex = 62
				line.Parent = wrapper
			elseif kind == "Label" then
				local labelText = Instance.new("TextLabel")
				labelText.Name = "Text"
				labelText.BackgroundTransparency = 1
				labelText.BorderSizePixel = 0
				labelText.Position = UDim2.fromOffset(0, 0)
				labelText.Size = UDim2.new(1, 0, 1, 0)
				labelText.AutomaticSize = Enum.AutomaticSize.None
				labelText.FontFace = Theme.GetFace()
				labelText.Text = tostring(item.Text or "")
				labelText.TextColor3 = colors.TextPrimary
				labelText.TextSize = itemTextSize
				labelText.TextTruncate = Enum.TextTruncate.None
				labelText.TextWrapped = false
				labelText.TextXAlignment = Enum.TextXAlignment.Center
				labelText.ZIndex = 62
				labelText.Parent = wrapper
				FitText.fit(labelText, {
					Base = itemTextSize,
					Min = 14,
				})
			else
				ButtonRow({
					Parent = wrapper,
					Buttons = { { Text = item.Text, Fire = item.Fire } },
				})
			end
		end
	end

	popup = container
	activeClose = closePopup
	genv.GDH_MOBILE_POPUP_CLOSE = closePopup

	popupConn = (menu :: Instance):GetPropertyChangedSignal("Visible"):Connect(function()
		if (menu :: Instance).Visible == false then
			closePopup()
		end
	end)
end

return HackSettings

end
MODULES["src/interface/Mobile/Widgets/InfoPopup.luau"] = function()
local function importMobileModule(name: string)
	local genv = (typeof(getgenv) == "function" and getgenv())
		or (typeof(_G) == "table" and _G)
		or {}
	local Import = genv.Import
	if Import then
		local module = Import("interface/Mobile/" .. name)
		if module ~= nil then
			return module
		end
	end
	local parent = script.Parent
	if parent.Name == "Widgets" then
		parent = parent.Parent
	end
	return require(parent[name])
end

local Theme = nil
local Animate = nil
local PressFlow = nil

local function init()
	if not Theme then
		Theme = importMobileModule("Theme")
	end
	if not Animate then
		Animate = importMobileModule("Animate")
	end
	if not PressFlow then
		PressFlow = importMobileModule("PressFlow")
	end
end

local InfoPopup = {}

local current: Frame? = nil
local hostConn: RBXScriptConnection? = nil

function InfoPopup.Close()
	if hostConn ~= nil then
		pcall(function()
			hostConn:Disconnect()
		end)
		hostConn = nil
	end
	local existing = current
	current = nil
	if existing ~= nil then
		pcall(function()
			existing:Destroy()
		end)
	end
end

function InfoPopup.Show(host: Instance, titleText: string, messageText: string, panelScale: number?)
	init()
	InfoPopup.Close()
	if typeof(host) ~= "Instance" then
		return
	end
	local menuFrame = host :: Frame
	if menuFrame.Parent == nil then
		return
	end

	local layout = Theme.Layout
	local colors = Theme.Colors

	local infoW = math.floor(layout.BgW * 0.65 + 0.5)
	local infoH = math.floor(layout.BgH * 0.65 + 0.5)
	local corner = math.floor(layout.BgCorner * (infoW / layout.BgW) + 0.5)
	local okW = math.floor(infoW * 0.18 + 0.5)
	local okH = math.floor(infoH * 0.215 + 0.5)
	local okBottom = math.floor(infoH * 0.094 + 0.5)
	local titleSize = math.floor(infoH * 0.15 + 0.5)
	local titleCenter = math.floor(infoH * 0.18 + 0.5)
	local titleH = math.floor(titleSize * 1.15 + 0.5)
	local bodySize = math.floor(infoH * 0.103 + 0.5)
	local bodyTop = titleCenter + math.floor(titleH / 2) + 12
	local okTextSize = math.floor(infoH * 0.11 + 0.5)

	local container = Instance.new("Frame")
	container.Name = "InfoPopup"
	container.Active = true
	container.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	container.BackgroundTransparency = 0.45
	container.BorderSizePixel = 0
	container.Position = UDim2.fromOffset(-2, -2)
	container.Size = UDim2.new(1, 12, 1, 12)
	container.ZIndex = 70
	container.Parent = menuFrame

	PressFlow.Register({
		Node = container,
	})

	local panel = Instance.new("Frame")
	panel.Name = "Panel"
	panel.Active = true
	panel.BackgroundColor3 = colors.MenuBG
	panel.BorderSizePixel = 0
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.new(0.5, 0, 0.5, 0)
	panel.Size = UDim2.fromOffset(infoW, infoH)
	panel.ZIndex = 71
	panel.Parent = container

	local panelCorner = Instance.new("UICorner")
	panelCorner.CornerRadius = UDim.new(0, corner)
	panelCorner.Parent = panel

	local panelStroke = Instance.new("UIStroke")
	panelStroke.Color = colors.MenuStroke
	panelStroke.Thickness = layout.BgStroke
	panelStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	panelStroke.Parent = panel

	local popScale = Instance.new("UIScale")
	popScale.Scale = if typeof(panelScale) == "number" and panelScale > 0 then panelScale else 1
	popScale.Parent = panel

	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.BackgroundTransparency = 1
	title.BorderSizePixel = 0
	title.Position = UDim2.fromOffset(0, titleCenter - math.floor(titleH / 2))
	title.Size = UDim2.new(1, 0, 0, titleH)
	title.FontFace = Theme.GetFace()
	title.Text = tostring(titleText or "Info")
	title.TextColor3 = Color3.fromRGB(255, 188, 29)
	title.TextSize = titleSize
	title.TextXAlignment = Enum.TextXAlignment.Center
	title.TextYAlignment = Enum.TextYAlignment.Center
	title.ZIndex = 72
	title.Parent = panel

	local body = Instance.new("TextLabel")
	body.Name = "Body"
	body.BackgroundTransparency = 1
	body.BorderSizePixel = 0
	body.Position = UDim2.fromOffset(30, bodyTop)
	body.Size = UDim2.new(1, -60, 1, -(bodyTop + okH + okBottom + 18))
	body.FontFace = Theme.GetFace()
	body.Text = tostring(messageText or "")
	body.TextColor3 = colors.TextPrimary
	body.TextSize = bodySize
	body.TextWrapped = true
	body.TextXAlignment = Enum.TextXAlignment.Center
	body.TextYAlignment = Enum.TextYAlignment.Center
	body.ZIndex = 72
	body.Parent = panel

	local okBtn = Instance.new("TextButton")
	okBtn.Name = "OK"
	okBtn.AutoButtonColor = false
	okBtn.BackgroundColor3 = colors.SwitchTrackOff
	okBtn.BorderSizePixel = 0
	okBtn.AnchorPoint = Vector2.new(0.5, 1)
	okBtn.Position = UDim2.new(0.5, 0, 1, -okBottom)
	okBtn.Size = UDim2.fromOffset(okW, okH)
	okBtn.FontFace = Theme.GetFace()
	okBtn.Text = "OK"
	okBtn.TextColor3 = colors.TextPrimary
	okBtn.TextSize = okTextSize
	okBtn.ZIndex = 73
	okBtn.Parent = panel

	local okCorner = Instance.new("UICorner")
	okCorner.CornerRadius = UDim.new(0, math.floor(okH * 0.3 + 0.5))
	okCorner.Parent = okBtn

	local okStroke = Instance.new("UIStroke")
	okStroke.Color = colors.MenuStroke
	okStroke.Thickness = 2
	okStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	okStroke.Parent = okBtn

	local feedback = Animate.HoldFeedback(okBtn, okBtn, {
		Grow = 1.1,
		GrowTime = 0.15,
		ReleaseTime = 0.6,
		ReleaseStyle = Enum.EasingStyle.Elastic,
	})
	local okTarget = {
		Node = okBtn,
		PressIn = feedback.Press,
		PressOut = feedback.Reverse,
		Release = feedback.Release,
	}
	PressFlow.Register(okTarget)

	okBtn.InputBegan:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			PressFlow.Begin(okTarget, input)
		end
	end)

	okBtn.Activated:Connect(function()
		InfoPopup.Close()
	end)

	current = container

	container.Destroying:Connect(function()
		if current == container then
			current = nil
		end
	end)

	hostConn = menuFrame:GetPropertyChangedSignal("Visible"):Connect(function()
		if menuFrame.Visible == false then
			InfoPopup.Close()
		end
	end)
end

return InfoPopup

end
MODULES["src/interface/Mobile/Widgets/NumberInput.luau"] = function()
local function importMobileModule(name: string)
    local genv = (typeof(getgenv) == "function" and getgenv())
        or (typeof(_G) == "table" and _G)
        or {}
    local Import = genv.Import
    if Import then
        local module = Import("interface/Mobile/" .. name)
        if module ~= nil then
            return module
        end
    end
    local parent = script.Parent
    if parent.Name == "Widgets" then
        parent = parent.Parent
    end
    return require(parent[name])
end

local Theme = nil
local FitText = nil

local function init()
    if not Theme then
        Theme = importMobileModule("Theme")
    end
    if not FitText then
        FitText = importMobileModule("FitText")
    end
end

export type NumberInputConfig = {
    Parent: Instance,
    IsFloat: boolean?,
    Name: any?,
    Min: any?,
    Max: any?,
    Default: any?,
    Get: any?,
    Set: any?,
    Center: boolean?,
    SliderSplit: string?,
}

local function NumberInput(config: NumberInputConfig): Frame
    init()

    local layout = Theme.Layout
    local colors = Theme.Colors

    local isFloat = config.IsFloat == true
    local minV = if typeof(config.Min) == "number" then config.Min :: number else 0
    local maxV = if typeof(config.Max) == "number" then config.Max :: number else 9999

    local cell = Instance.new("Frame")
    cell.Name = "NumberInput"
    cell.BackgroundTransparency = 1
    cell.BorderSizePixel = 0
    if config.SliderSplit == "left" then
        cell.Size = UDim2.new(layout.SliderToggleX, -50, 0, layout.RowH)
    elseif config.SliderSplit == "right" then
        cell.Size = UDim2.new(1 - layout.SliderToggleX, 0, 0, layout.RowH)
    else
        cell.Size = UDim2.fromOffset(layout.CellW, layout.RowH)
    end
    cell.Parent = config.Parent

    local centerMode = config.Center == true
    local contentHost: Instance = cell
    if centerMode then
        cell.Size = UDim2.new(1, 0, 0, layout.RowH)
        local holder = Instance.new("Frame")
        holder.Name = "Content"
        holder.BackgroundTransparency = 1
        holder.BorderSizePixel = 0
        holder.AnchorPoint = Vector2.new(0.5, 0.5)
        holder.Position = UDim2.fromScale(0.5, 0.5)
        holder.Size = UDim2.new(0, 0, 1, 0)
        holder.AutomaticSize = Enum.AutomaticSize.X
        holder.Parent = cell
        local holderLayout = Instance.new("UIListLayout")
        holderLayout.FillDirection = Enum.FillDirection.Horizontal
        holderLayout.Padding = UDim.new(0, 8)
        holderLayout.SortOrder = Enum.SortOrder.LayoutOrder
        holderLayout.VerticalAlignment = Enum.VerticalAlignment.Center
        holderLayout.Parent = holder
        contentHost = holder
    end

    local box = Instance.new("TextBox")
    box.Name = "Input"
    box.BackgroundColor3 = colors.InputBG
    box.BorderSizePixel = 0
    box.Position = UDim2.fromOffset(0, (layout.RowH - layout.InputH) / 2)
    box.Size = UDim2.fromOffset(layout.InputW, layout.InputH)
    box.FontFace = Theme.GetFace()
    box.TextColor3 = colors.TextPrimary
    box.TextSize = layout.BoxTextSize
    box.ClearTextOnFocus = false
    box.ClipsDescendants = true
    if centerMode then
        box.LayoutOrder = 1
    end
    box.Parent = if centerMode then contentHost else cell

    local boxCorner = Instance.new("UICorner")
    boxCorner.CornerRadius = UDim.new(0, layout.InputCorner)
    boxCorner.Parent = box

    local label = Instance.new("TextLabel")
    label.Name = "Label"
    label.BackgroundTransparency = 1
    label.BorderSizePixel = 0
    if centerMode then
        label.AutomaticSize = Enum.AutomaticSize.X
        label.Size = UDim2.new(0, 0, 1, 0)
        label.LayoutOrder = 2
    else
        label.Position = UDim2.fromOffset(layout.InputW + 8, 0)
        label.Size = UDim2.new(1, -(layout.InputW + 12), 1, 0)
    end
    label.FontFace = Theme.GetFace()
    label.Text = tostring(config.Name or "")
    label.TextColor3 = colors.TextPrimary
    label.TextSize = layout.LabelSize
    label.TextTruncate = Enum.TextTruncate.AtEnd
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = if centerMode then contentHost else cell
    if not centerMode then
        FitText.fit(label, {
            Base = layout.LabelSize,
            Min = layout.LabelMinSize,
        })
    end

    local function formatValue(value: number): string
        if isFloat then
            return string.format("%.2f", value)
        end
        return tostring(math.floor(value))
    end

    local startText = formatValue(0)
    if typeof(config.Get) == "function" then
        local ok, value = pcall(config.Get :: any)
        if ok and typeof(value) == "number" then
            startText = formatValue(value)
        end
    elseif typeof(config.Default) == "number" then
        startText = formatValue(config.Default :: number)
    end
    box.Text = startText

    box.FocusLost:Connect(function()
        local value = tonumber(box.Text)
        if value == nil then
            box.Text = startText
            return
        end
        if not isFloat then
            value = math.floor(value)
        end
        value = math.clamp(value, minV, maxV)
        local text = formatValue(value)
        box.Text = text
        startText = text
        if typeof(config.Set) == "function" then
            pcall(config.Set :: any, value)
        end
    end)

    return cell
end

return NumberInput

end
MODULES["src/interface/Mobile/Widgets/OverlayButton.luau"] = function()
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local function importMobileModule(name: string)
    local genv = (typeof(getgenv) == "function" and getgenv())
        or (typeof(_G) == "table" and _G)
        or {}
    local Import = genv.Import
    if Import then
        local module = Import("interface/Mobile/" .. name)
        if module ~= nil then
            return module
        end
    end
    local parent = script.Parent
    if parent.Name == "Widgets" then
        parent = parent.Parent
    end
    return require(parent[name])
end

local Theme = nil
local Animate = nil

local function init()
    if not Theme then
        Theme = importMobileModule("Theme")
    end
    if not Animate then
        Animate = importMobileModule("Animate")
    end
end

export type OverlayButtonConfig = {
    Root: GuiObject,
    Size: number?,
    MinOpacity: number?,
    OnActivated: (() -> ())?,
}

local function OverlayButton(config: OverlayButtonConfig): any
    init()

    local colors = Theme.Colors
    local assets = Theme.GetAssets()
    local root = config.Root

    local iconSize = if config.Size ~= nil then config.Size else Theme.Layout.IconBase

    local idleTransparency = 0.2
    if typeof(config.MinOpacity) == "number" then
        idleTransparency = math.clamp(1 - (config.MinOpacity :: number), 0, 1)
    end

    local buttonImage = assets.ButtonUI
    local hasImage = buttonImage ~= nil and buttonImage ~= ""

    local button = Instance.new("Frame")
    button.Name = "ToggleIcon"
    button.Active = true
    button.AnchorPoint = Vector2.new(0.5, 0.5)
    button.BackgroundColor3 = colors.MenuBG
    button.BackgroundTransparency = if hasImage then 1 else idleTransparency
    button.BorderSizePixel = 0
    button.Position = UDim2.fromOffset(80, 500)
    button.Size = UDim2.fromOffset(iconSize, iconSize)
    button.ZIndex = 20
    button.Parent = root

    if not hasImage then
        local iconCorner = Instance.new("UICorner")
        iconCorner.CornerRadius = UDim.new(1, 0)
        iconCorner.Parent = button
    end

    local iconImage = Instance.new("ImageLabel")
    iconImage.Name = "ButtonImage"
    iconImage.BackgroundTransparency = 1
    iconImage.BorderSizePixel = 0
    iconImage.AnchorPoint = Vector2.new(0.5, 0.5)
    iconImage.Position = UDim2.fromScale(0.5, 0.5)
    iconImage.Size = UDim2.fromScale(1, 1)
    iconImage.ScaleType = Enum.ScaleType.Fit
    iconImage.Image = if hasImage then (buttonImage :: string) else ""
    iconImage.ImageTransparency = idleTransparency
    iconImage.Parent = button

    local function fadeVisual(value: number, seconds: number, style: Enum.EasingStyle)
        Animate.Tween(iconImage, seconds, style, Enum.EasingDirection.Out, {
            ImageTransparency = value,
        })
        if not hasImage then
            Animate.Tween(button, seconds, style, Enum.EasingDirection.Out, {
                BackgroundTransparency = value,
            })
        end
    end

    local target: Vector2? = nil
    local center: Vector2? = nil
    local dragging = false
    local moved = false
    local dragStartInput: Vector2? = nil
    local dragStartCenter: Vector2? = nil

    local connections: { RBXScriptConnection } = {}

    local function clampTarget()
        local t = target
        if t == nil then
            return
        end
        local size = root.AbsoluteSize
        if size.X <= 0 or size.Y <= 0 then
            return
        end
        local r = iconSize * 0.6
        local clampedX = math.clamp(t.X, r, math.max(r, size.X - r))
        local clampedY = math.clamp(t.Y, r, math.max(r, size.Y - r))
        if clampedX ~= t.X or clampedY ~= t.Y then
            target = Vector2.new(clampedX, clampedY)
        end
    end

    local function pressAnim()
        Animate.Tween(button, 0.08, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, {
            Size = UDim2.fromOffset(iconSize * 0.85, iconSize * 0.85),
        })
        fadeVisual(0.05, 0.08, Enum.EasingStyle.Linear)
    end

    local function releaseAnim()
        Animate.Tween(button, 0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out, {
            Size = UDim2.fromOffset(iconSize, iconSize),
        })
        task.delay(0.8, function()
            if dragging then
                return
            end
            if button.Parent ~= nil then
                fadeVisual(idleTransparency, 0.3, Enum.EasingStyle.Quad)
            end
        end)
    end

    table.insert(connections, RunService.RenderStepped:Connect(function(dt: number)
        local t = target
        local c = center
        if t == nil or c == nil then
            return
        end
        clampTarget()
        t = target :: Vector2
        if (t - c).Magnitude < 0.5 then
            return
        end
        local blend = math.min(1, 12 * dt)
        local nextCenter = c + (t - c) * blend
        center = nextCenter
        button.Position = UDim2.fromOffset(math.floor(nextCenter.X + 0.5), math.floor(nextCenter.Y + 0.5))
    end))

    button.InputBegan:Connect(function(input: InputObject)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch
        then
            return
        end
        dragging = true
        moved = false
        dragStartInput = Vector2.new(input.Position.X, input.Position.Y)
        dragStartCenter = center
        pressAnim()
    end)

    table.insert(connections, UserInputService.InputChanged:Connect(function(input: InputObject)
        if not dragging then
            return
        end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
            and input.UserInputType ~= Enum.UserInputType.Touch
        then
            return
        end
        local startInput = dragStartInput
        local startCenter = dragStartCenter
        if startInput == nil or startCenter == nil then
            return
        end
        local delta = Vector2.new(input.Position.X, input.Position.Y) - startInput
        local r = iconSize * 0.5
        if not moved and delta.Magnitude <= r then
            return
        end
        moved = true
        target = startCenter + delta
    end))

    table.insert(connections, UserInputService.InputEnded:Connect(function(input: InputObject)
        if not dragging then
            return
        end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch
        then
            return
        end
        dragging = false
        releaseAnim()
        if not moved then
            if typeof(config.OnActivated) == "function" then
                config.OnActivated()
            end
        end
    end))

    local function Destroy()
        for _, conn in connections do
            pcall(function()
                conn:Disconnect()
            end)
        end
        table.clear(connections)
        pcall(function()
            button:Destroy()
        end)
    end

    button.Destroying:Connect(Destroy)

    return {
        Button = button,
        GetSize = function(): number
            return iconSize
        end,
        SetSize = function(size: number)
            iconSize = size
            if not dragging then
                button.Size = UDim2.fromOffset(size, size)
            end
            clampTarget()
        end,
        SetCenter = function(v: Vector2)
            target = v
            center = v
            button.Position = UDim2.fromOffset(v.X, v.Y)
        end,
        SetMinOpacity = function(opacity: number)
            if typeof(opacity) ~= "number" then
                return
            end
            idleTransparency = math.clamp(1 - opacity, 0, 1)
            if not dragging then
                fadeVisual(idleTransparency, 0.25, Enum.EasingStyle.Quad)
            end
        end,
        GetCenter = function(): Vector2?
            return center
        end,
        ClampTarget = clampTarget,
        Destroy = Destroy,
    }
end

return OverlayButton

end
